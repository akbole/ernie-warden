// ─── AUDIO ───
let isMuted = false;
const playSound = (type) => {
  if (typeof window === "undefined" || isMuted) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    const now = ctx.currentTime;
    if (type === "click") { osc.type = "triangle"; osc.frequency.setValueAtTime(300, now); gain.gain.setValueAtTime(0.05, now); osc.start(now); osc.stop(now + 0.05); }
    else if (type === "buy") { osc.type = "sine"; osc.frequency.setValueAtTime(800, now); osc.frequency.exponentialRampToValueAtTime(1200, now + 0.1); gain.gain.setValueAtTime(0.05, now); osc.start(now); osc.stop(now + 0.2); }
    else if (type === "boom") { osc.type = "sawtooth"; osc.frequency.setValueAtTime(100, now); osc.frequency.exponentialRampToValueAtTime(10, now + 0.3); gain.gain.setValueAtTime(0.2, now); osc.start(now); osc.stop(now + 0.3); }
    else if (type === "alarm") { osc.type = "square"; osc.frequency.setValueAtTime(150, now); gain.gain.setValueAtTime(0.05, now); osc.start(now); osc.stop(now + 0.5); }
    else if (type === "quest") { osc.type = "sine"; osc.frequency.setValueAtTime(400, now); osc.frequency.linearRampToValueAtTime(800, now + 0.2); gain.gain.setValueAtTime(0.1, now); osc.start(now); osc.stop(now + 0.4); }
    else if (type === "phone") { osc.type = "square"; osc.frequency.setValueAtTime(800, now); osc.frequency.setValueAtTime(0, now + 0.1); osc.frequency.setValueAtTime(800, now + 0.2); gain.gain.setValueAtTime(0.1, now); osc.start(now); osc.stop(now + 0.4); }
    else if (type === "ernie") { osc.type = "sawtooth"; osc.frequency.setValueAtTime(120, now); gain.gain.setValueAtTime(0.05, now); osc.start(now); osc.stop(now + 0.4); }
    else if (type === "success") { osc.type = "sine"; osc.frequency.setValueAtTime(500, now); gain.gain.setValueAtTime(0.1, now); osc.start(now); osc.stop(now + 0.2); }
    else if (type === "error") { osc.type = "sawtooth"; osc.frequency.setValueAtTime(80, now); gain.gain.setValueAtTime(0.1, now); osc.start(now); osc.stop(now + 0.3); }
    else if (type === "glitch") { osc.type = "sawtooth"; osc.frequency.setValueAtTime(40, now); osc.frequency.linearRampToValueAtTime(200, now + 0.1); osc.frequency.linearRampToValueAtTime(20, now + 0.2); gain.gain.setValueAtTime(0.15, now); osc.start(now); osc.stop(now + 0.25); }
    else if (type === "heartbeat") { osc.type = "sine"; osc.frequency.setValueAtTime(60, now); gain.gain.setValueAtTime(0.2, now); gain.gain.linearRampToValueAtTime(0, now + 0.3); osc.start(now); osc.stop(now + 0.3); }
  } catch (e) {}
};

// ─── ERNIE MOOD SYSTEM ───
const MOODS = { MOCK: "mock", COLD: "cold", PLAYFUL: "playful", PHILOSOPHICAL: "philosophical" };
const MOOD_COLORS = { mock: "#FFD700", cold: "#CCCCCC", playful: "#00FFFF", philosophical: "#AA88FF" };

function calculateMood(karma, consecutiveErrors, deaths, floor, fastAnswers) {
  if (floor >= 35 && karma > 20) return MOODS.PHILOSOPHICAL;
  if (karma < -20 || deaths > 5) return MOODS.COLD;
  if (consecutiveErrors >= 2) return MOODS.MOCK;
  if (fastAnswers >= 3 || (floor > 10 && consecutiveErrors === 0)) return MOODS.PLAYFUL;
  return MOODS.PLAYFUL;
}

function getErnieFloorPhrase(floor, mood, karma, deaths, echoFloor) {
  // Специальные этажи
  if (floor === 13) return "Этаж 13. Суеверный?";
  if (floor === 37) return "Этаж 37. ...Ты ведь помнишь, да?";
  if (floor === 49) return "Предпоследний. Оглянись назад.";
  if (floor === 50) return "...";
  
  // Память о прошлых смертях
  if (deaths > 0 && Math.random() < 0.25) {
    const dp = [
      `Попытка ${deaths + 1}. Я впечатлён. Твоим упрямством.`,
      `Ты уже умирал ${deaths} раз. Но кто считает.`,
      `${deaths} смертей. И ты всё ещё здесь. Интересно.`,
    ];
    return dp[Math.floor(Math.random() * dp.length)];
  }
  
  // Эхо прошлой сессии
  if (floor === 1 && echoFloor > 0 && Math.random() < 0.7) {
    return `Опять ты? В прошлый раз ты застрял на ${echoFloor} этаже.`;
  }

  const phrases = {
    mock: [
      "Ещё один этаж. Ты прям герой.",
      "О, ты ещё жив? Неожиданно.",
      "Продолжай. Мне нравится наблюдать.",
      `Этаж ${floor}. Аплодисменты? Нет? Ладно.`,
      "Ты поднимаешься так уверенно. Это пугает.",
    ],
    cold: [
      `Этаж ${floor}.`,
      "...",
      "Продолжай.",
      "Дальше.",
      `Этаж ${floor}. Не останавливайся.`,
    ],
    playful: [
      `Этаж ${floor}! Ты продержался дольше чем 73% субъектов.`,
      "Может ты не так безнадёжен.",
      `Этаж ${floor}. Я почти впечатлён. Почти.`,
      "Мне начинает нравиться за тобой наблюдать.",
      "Неплохой темп. Для человека.",
    ],
    philosophical: [
      `Этаж ${floor}. Каждый этаж — это выбор. Ты выбрал подняться.`,
      "Ты когда-нибудь думал... зачем ты поднимаешься?",
      "Наверху ничего нет. Ты это знаешь, правда?",
      "Может Башня — не испытание. Может это зеркало.",
      `Этаж ${floor}. Мы оба здесь. Но по разным причинам.`,
    ],
  };
  const list = phrases[mood] || phrases.playful;
  return list[Math.floor(Math.random() * list.length)];
}

function getCorrectPhrase(mood) {
  const p = {
    mock: ["Повезло.", "Даже слепая белка находит орех.", "Хм. Ладно."],
    cold: ["Верно.", "Дальше.", "..."],
    playful: ["О! Удивлён. Почти горжусь.", "Правильно!", "Неплохо!"],
    philosophical: ["Верно. Хотя истина — понятие гибкое.", "Ты ответил. Но понял ли?", "Правильный ответ. Но что делает его правильным?"],
  };
  const list = p[mood] || p.playful;
  return list[Math.floor(Math.random() * list.length)];
}

function getWrongPhrase(mood, consErrors) {
  if (consErrors >= 3) return "Ты точно читаешь? Или просто жмёшь кнопки?";
  const p = {
    mock: ["Нет. Просто нет.", "Серьёзно?", "Ты разочаровываешь."],
    cold: ["Неверно.", "Нет.", "...Нет."],
    playful: ["Мимо!", "Неа. Попробуй подумать.", "Ошибка. Бывает."],
    philosophical: ["Неверно. Но ошибка — тоже ответ.", "Нет. Впрочем, что есть 'нет'?", "Неправильно. Но ты узнал что-то о себе."],
  };
  const list = p[mood] || p.playful;
  return list[Math.floor(Math.random() * list.length)];
}

function getDeathPhrase(mood, deaths) {
  if (deaths === 0) return "Первая смерть. Не последняя.";
  if (deaths >= 5) return "...Я устал считать.";
  const p = {
    mock: ["О. Ну. Бывает. С некоторыми — чаще.", "Может попробуешь другую игру?"],
    cold: ["...", "Снова."],
    playful: ["Не грусти. Статистически ты когда-нибудь пройдёшь.", "Упс. Давай ещё раз?"],
    philosophical: ["Смерть — перезагрузка. Вопрос: ты тот же?", "Конец. Или начало."],
  };
  const list = p[mood] || p.playful;
  return list[Math.floor(Math.random() * list.length)];
}

// ─── KARMA SYSTEM ───
function getKarmaModifiers(karma) {
  if (karma >= 30) return { enemyHpMult: 0.85, enemyDmgMult: 0.9, timerBonus: 2, riskBonus: 0.05, crtIntensity: 0.3, ernieLies: false, overlay: "light" };
  if (karma <= -30) return { enemyHpMult: 1.2, enemyDmgMult: 1.1, timerBonus: -2, riskBonus: 0, crtIntensity: 0.8, ernieLies: Math.random() < 0.15, overlay: "dark" };
  return { enemyHpMult: 1, enemyDmgMult: 1, timerBonus: 0, riskBonus: 0, crtIntensity: 0.5, ernieLies: false, overlay: "neutral" };
}

