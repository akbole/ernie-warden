// --- HOOKS & HELPERS ---
function useTypewriter(fullText, speed = 35) {
  const [displayed, setDisplayed] = useState("");
  const [done, setDone] = useState(false);
  const ref = useRef(null);
  useEffect(() => {
    setDisplayed("");
    setDone(false);
    let i = 0;
    clearInterval(ref.current);
    if (!fullText) return;
    ref.current = setInterval(() => {
      i++;
      setDisplayed(fullText.slice(0, i));
      if (i >= fullText.length) {
        clearInterval(ref.current);
        setTimeout(() => setDone(true), 300);
      }
    }, speed);
    return () => clearInterval(ref.current);
  }, [fullText, speed]);
  return { displayed, done };
}

function EnergyPulse({ energy, max, influence, cycle }) {
  const pct = Math.max(0, Math.min(1, energy / max));
  let color = pct < 0.2 ? "#FF0000" : pct < 0.5 ? "#E94560" : "#666";
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
      <div style={{ display: "flex", alignItems: "center", gap: 5 }}>
        <span style={{ fontSize: 11, color: "#666" }}>⚡</span>
        <div
          style={{
            width: 70,
            height: 8,
            background: "#111",
            borderRadius: 4,
            border: "1px solid #333",
            overflow: "hidden",
          }}
        >
          <div
            style={{
              width: `${pct * 100}%`,
              height: "100%",
              background: `linear-gradient(90deg, ${color}, #fff)`,
              transition: "width 0.5s ease",
            }}
          />
        </div>
        <span style={{ fontSize: 10, color: "#ccc", fontWeight: "bold" }}>
          {Math.floor(energy)}
        </span>
      </div>
      <div
        style={{
          fontSize: 10,
          color: "#E0C068",
          fontWeight: "bold",
          border: "1px solid #E0C068",
          padding: "2px 5px",
          borderRadius: 4,
        }}
      >
        👑 {influence}
      </div>
      {cycle > 0 && (
        <div style={{ fontSize: 10, color: "#A020F0", fontWeight: "bold" }}>
          🌀 {cycle}
        </div>
      )}
    </div>
  );
}

