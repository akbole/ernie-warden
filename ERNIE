        const passed =
          (type === "floor" && val >= c.target) ||
          (type === "influence" && val >= c.target) ||
          type === "item" ||
          type === "boss" ||
          type === "glitch";
        if (passed) {
          setInfluence((i) => i + c.reward);
          spawnFloater(`+${c.reward} ВЛ`, "#ffd700");
          setTrialResult(`КОНТРАКТ: +${c.reward} ВЛ`);
          playSound("quest");
          triggerFlash("green");
          completed = true;
          return false;
        }
      }
      return true;
    });
    if (completed) {
      const fresh =
        CONTRACTS_DB[Math.floor(Math.random() * CONTRACTS_DB.length)];
      setContracts([...newContracts, { ...fresh, id: Date.now() }]);
    }
  };

  // ACTIONS
  const answerCall = () => {
    playSound("click");
    setIncomingCall(false);
    setActiveRiddle(RIDDLES[floor]); // Open the riddle for the CURRENT floor
  };

  const handleRiddleAnswer = (isCorrect) => {
    playSound("click");
    if (isCorrect) {
      playSound("success");
      triggerFlash("green");
      spawnFloater("+30 EN", "#0f0");
      setEnergy((e) => Math.min(e + 30, max));
      setInfluence((i) => i + 2);
      setTrialResult(activeRiddle.win);
    } else {
      triggerDamageFX();
      spawnFloater("-20 EN", "red");
      setEnergy((e) => Math.max(0, e - 20));
      setTrialResult(activeRiddle.fail);
    }
    setActiveRiddle(null);
  };

  const useItem = (itemId) => {
    const itemDef = ITEMS[itemId];
    if (!itemDef) return;
    checkContracts("item", 1);
    if (itemDef.type === "combat") {
      if (!bossData) {
        setTrialResult("НУЖНА ЦЕЛЬ (БОЙ).");
        return;
      }
      itemDef.effect({
        damageEnemy: (amt) => {
          setBossData((p) => ({
            ...p,
            hp: p.hp - amt,
            log: [...p.log.slice(-2), `ГРАНАТА! (-${amt})`],
          }));
          playSound("boom");
          triggerFlash("green");
          triggerShake();
          spawnFloater(`-${amt}`, "red");
          if (bossData.hp - amt <= 0) {
            setBossData(null);
            if (bossData.name === "СИСТЕМА БЕЗОПАСНОСТИ") {
              setInventory((p) => [...p, "architect"]);
              setInfluence((i) => i + 10);
              checkContracts("boss", 1);
              spawnFloater("+10 ВЛ", "#ffd700");
            } else {
              setInfluence((i) => i + 2);
              spawnFloater("+2 ВЛ", "#ffd700");
            }
            setTrialResult("ВРАГ УНИЧТОЖЕН.");
          }
        },
      });
    } else {
      playSound("success");
      itemDef.effect({
        addEnergy: (amt) => {
          setEnergy((e) => Math.min(e + amt, max));
          spawnFloater(`+${amt} EN`, "#0f0");
        },
        resetRisk: () => {
          setRiskUsedThisCycle(0);
          spawnFloater("СБРОС", "#fff");
        },
        openArchitect: () => {
          setShowArchitect(true);
          return;
        },
      });
      if (itemId === "architect") {
        setShowBag(false);
        setShowArchitect(true);
        return;
      }
      if (itemId === "silence" || itemId === "mirror") return;
    }
    if (itemDef.type !== "key") {
      setInventory((prev) => {
        const idx = prev.indexOf(itemId);
        if (idx > -1) {
          const n = [...prev];
          n.splice(idx, 1);
          return n;
        }
        return prev;
      });
    }
    setShowBag(false);
  };

  const buyItem = (id, cost) => {
    if (influence >= cost) {
      playSound("buy");
      setInfluence((i) => i - cost);
      setInventory((p) => [...p, id]);
      triggerFlash("green");
      spawnFloater("-ВЛ", "#ffd700");
    } else {
      playSound("error");
      triggerFlash("red");
    }
  };

  const handleRisk = () => {
    if (!canRisk) return;
    playSound("click");
    setEnergy((e) => Math.max(0, e - 20));
    setRiskUsedThisCycle((c) => c + 1);
    if (Math.random() > 0.5) {
      playSound("success");
      setEnergy((e) => Math.min(e + 45, max));
      setInfluence((i) => i + 1);
      spawnFloater("+45 EN", "#0f0");
      setTrialResult("УСПЕХ! +45 ЭН");
      triggerFlash("green");
    } else {
      playSound("error");
      setTrialResult("ПУСТОТА...");
      triggerFlash("red");
      triggerDamageFX();
      spawnFloater("ПУСТО", "#666");
    }
  };

  const handleReboot = () => {
    playSound("click");
    setIsGlitchActive(false);
    setEnergy((e) => Math.min(e + 20, max));
    setTrialResult("СИСТЕМА ВОССТАНОВЛЕНА.");
    triggerFlash("green");
    checkContracts("glitch", 1);
  };

  const combatAction = (type) => {
    if (!bossData) return;
    playSound("click");
    let dmg = 0;
    let cost = 0;
    let logMsg = "";
    if (type === "attack") {
      cost = 10;
      dmg = role === "LEADER" ? 25 : 15;
      logMsg = "УДАР";
    } else if (type === "hack") {
      cost = 15;
      dmg = role === "ELITE" ? 35 : Math.random() > 0.3 ? 30 : 0;
      logMsg = dmg > 0 ? "ВЗЛОМ" : "СБОЙ";
    }

    if (energy < cost) {
      setBossData((p) => ({
        ...p,
        log: [...p.log.slice(-2), "НЕДОСТАТОЧНО ЭНЕРГИИ!"],
      }));
      return;
    }
    setEnergy((e) => e - cost);

    const newHp = bossData.hp - dmg;
    spawnFloater(`-${dmg}`, "orange");

    if (newHp <= 0) {
      playSound("success");
      setBossData(null);
      if (bossData.name === "СИСТЕМА БЕЗОПАСНОСТИ") {
        setInventory((p) => [...p, "architect"]);
        setInfluence((i) => i + 10);
        checkContracts("boss", 1);
        spawnFloater("+10 ВЛ", "#ffd700");
      } else {
        setInfluence((i) => i + 2);
        spawnFloater("+2 ВЛ", "#ffd700");
      }
      setTrialResult("ПОБЕДА.");
      triggerFlash("green");
    } else {
      const enemyDmg = bossData.damage;
      setEnergy((e) => Math.max(0, e - enemyDmg));
      triggerDamageFX();
      triggerFlash("red");
      setBossData((p) => ({
        ...p,
        hp: newHp,
        log: [...p.log.slice(-2), `${logMsg} (-${dmg})`, `УРОН (-${enemyDmg})`],
      }));
    }
  };

  const ascend = () => {
    if (!canAscend) return;
    playSound("click");

    const nextFloor = floor + 1;
    checkContracts("floor", nextFloor);
    if (getZone(floor).name !== getZone(nextFloor).name) {
      setZoneNotification(getZone(nextFloor).name);
      setTimeout(() => setZoneNotification(null), 3000);
    }

    // Just advance the floor. The useEffect will handle Events.
    setPhase("ascending");
    setEnergy((e) => e - cost);
    setTrialResult(null);
    setRiskUsedThisCycle(0);

    // Minor random events
    const rand = Math.random();
    if (
      rand < 0.15 &&
      floor > 5 &&
      !activeEvent &&
      !activeRiddle &&
      !incomingCall &&
      !bossData
    ) {
      setTimeout(
        () =>
          setActiveEvent(
            RANDOM_EVENTS[Math.floor(Math.random() * RANDOM_EVENTS.length)]
          ),
        1000
      );
    } else if (rand < ghostChance && floor > 3 && !bossData && !incomingCall) {
      setTimeout(() => {
        playSound("alarm");
        setIsGlitchActive(true);
      }, 1500);
    }

    if (floor % 5 === 0) {
      setInfluence((i) => i + 2);
      checkContracts("influence", influence + 2);
      spawnFloater("+2 ВЛ", "#ffd700");
    }
    setTimeout(() => {
      setFloor((f) => Math.min(f + 1, 50));
      setPhase("floor");
    }, 2000);
  };

  const spawnEnemy = (type) => {
    playSound("alarm");
    const difficultyMult = 1 + cycle * 0.5;
    const eData = ENEMIES[type] || ENEMIES.BOSS;
    setBossData({
      ...eData,
      hp: eData.hp * difficultyMult,
      maxHp: eData.maxHp * difficultyMult,
      damage: Math.floor(eData.damage * difficultyMult),
      log: ["ЦЕЛЬ ЗАХВАЧЕНА."],
    });
    setPhase("floor");
  };
  const handleDescent = () => {
    setFloor((f) => Math.max(1, f - 5));
    setEnergy(30);
    setPhase("floor");
    setTrialResult("АВАРИЙНЫЙ СПУСК.");
    playSound("error");
    triggerDamageFX();
  };
  const handleSOS = () => {
    setSosLoading(true);
    playSound("click");
    setTimeout(() => {
      setFloor((f) => Math.max(1, f - 5));
      setEnergy(100);
      setPhase("floor");
      setSosLoading(false);
    }, 2000);
  };
  const debugAddAllRelics = () => setRelics(RELICS_DB.map((r) => r.id));
  const debugAddKey = () =>
    setInventory((p) => [...p, "architect", "emp", "battery"]);
  const debugGhost = () => {
    playSound("alarm");
    setIsGlitchActive(true);
  };
  const debugBoss = () => spawnEnemy("BOSS");
  const debugInfl = () => setInfluence((i) => i + 5);
  const triggerGhost = () => {
    playSound("alarm");
    setIsGlitchActive(true);
  };
  const handleEventChoice = (action) => {
    playSound("click");
    if (action === "loot_corpse") {
      modifyKarma(-10);
      setInventory((p) => [...p, "mirror"]);
      setTrialResult("Найдено: Ключ Зеркала");
    }
    if (action === "bury_corpse") {
      modifyKarma(10);
      setTrialResult("Душа успокоена.");
    }
    if (action === "buy_drink") {
      if (influence >= 3) {
        setInfluence((i) => i - 3);
        setEnergy((e) => Math.min(e + 30, max));
        setTrialResult("Вкусно.");
      } else {
        setTrialResult("Нет денег.");
      }
    }
    if (action === "leave") {
      setTrialResult("Ты прошел мимо.");
    }
    setActiveEvent(null);
  };
  const triggerAscension = () => {
    playSound("success");
    setFloor(1);
    setEnergy(100);
    setInventory(["silence"]);
    setCycle((c) => c + 1);
    setShowEnding(false);
    setPhase("floor");
    setTrialResult(`ЦИКЛ ${cycle + 2} НАЧАЛСЯ.`);
  };
  const selectRole = (rId) => {
    playSound("click");
    setRole(rId.toUpperCase());
    setPhase("floor");
  };
  const triggerFlash = (type) => {
    setFxFlash(type);
    setTimeout(() => setFxFlash(null), 300);
  };
  const triggerDamageFX = () => {
    setDmgVignette(true);
    setTimeout(() => setDmgVignette(false), 400);
    triggerShake();
  };
  const triggerShake = () => {
    setShake(true);
    setTimeout(() => setShake(false), 300);
    playSound("error");
  };
  const buyUpgrade = (upg) => {
    if (influence >= upg.cost) {
      playSound("buy");
      setInfluence((i) => i - upg.cost);
      setUpgrades((p) => ({ ...p, [upg.code]: (p[upg.code] || 0) + 1 }));
      triggerFlash("green");
      spawnFloater("-ВЛ", "#ffd700");
    } else {
      playSound("error");
      triggerFlash("red");
    }
  };
  const retreatFromBoss = () => {
    setBossData(null);
    handleDescent();
  };
  const chatAction = (action) => {
    if (action === "requestEnergy" && influence >= 3) {
      playSound("success");
      setInfluence((i) => i - 3);
      setEnergy((e) => Math.min(e + 25, max));
      setChatLog((p) => [...p, { user: "Bot", text: "+25 ЭН" }]);
      spawnFloater("+25 EN", "#0f0");
    }
  };

  // 🔥 IMPORTANT: CENTRALIZED EVENT CHECKER
  useEffect(() => {
    // 1. ENDING
    if (floor === 50) {
      setShowEnding(true);
      return;
    }

    // 2. BOSS (10, 20, 30...)
    if (floor % 10 === 0 && floor > 1 && !bossData) {
      setTimeout(() => {
        playSound("alarm");
        const difficultyMult = 1 + cycle * 0.5;
        setBossData({
          ...ENEMIES.BOSS,
          hp: 100 * difficultyMult,
          maxHp: 100 * difficultyMult,
          damage: Math.floor(10 * difficultyMult),
          log: ["ОБНАРУЖЕНА УГРОЗА."],
        });
      }, 1000);
      return;
    }

    // 3. MERCHANT (9, 19, 29...)
    if ((floor + 1) % 10 === 0 && floor > 1) {
      setTimeout(() => setShowMerchant(true), 500);
    }

    // 4. RIDDLES (5, 15, 25...) - NEW: Trigger "Incoming Call" first
    if (
      (floor === 5 ||
        floor === 15 ||
        floor === 25 ||
        floor === 35 ||
        floor === 45) &&
      RIDDLES[floor] &&
      !activeRiddle &&
      !incomingCall
    ) {
      setTimeout(() => {
        playSound("phone");
        setIncomingCall(true);
      }, 500);
    }
  }, [floor]); // Runs every time floor changes

  // EFFECTS
  useEffect(() => {
    if (
      energy <= 0 &&
      phase !== "emergency" &&
      role &&
      !bossData &&
      !activeEvent &&
      !activeRiddle &&
      !incomingCall
    ) {
      setPhase("emergency");
      triggerFlash("red");
    }
  }, [energy, phase, role, bossData, activeEvent, activeRiddle, incomingCall]);
  useEffect(() => {
    if (role) {
      localStorage.setItem("ernie_floor", floor);
      localStorage.setItem("ernie_contracts", JSON.stringify(contracts));
      localStorage.setItem("ernie_energy", energy);
      localStorage.setItem("ernie_relics", JSON.stringify(relics));
      localStorage.setItem("ernie_inventory", JSON.stringify(inventory));
      localStorage.setItem("ernie_risk_cycle", riskUsedThisCycle);
      localStorage.setItem("ernie_role", role);
      localStorage.setItem("ernie_influence", influence);
      localStorage.setItem("ernie_upgrades", JSON.stringify(upgrades));
      localStorage.setItem("ernie_cycle", cycle);
    }
  }, [
    floor,
    energy,
    relics,
    inventory,
    riskUsedThisCycle,
    role,
    influence,
    upgrades,
    cycle,
    contracts,
  ]);
  useEffect(() => {
    let txt = "";
    if (bossData) txt = bossData.text;
    else if (isGlitchActive) txt = "⚠ ОШИБКА ⚠";
    else if (phase === "emergency") txt = "СБОЙ СИСТЕМЫ.";
    else txt = trialResult || (floor === 1 ? "Этаж 0." : "Системы в норме.");
    setCurrentText(txt);
  }, [floor, trialResult, phase, isGlitchActive, bossData]);
  useEffect(() => {
    if (showFloors && scrollRef.current)
      scrollRef.current.scrollTo({
        top: (50 - floor) * 30 - 100,
        behavior: "auto",
      });
  }, [showFloors, floor]);

  if (!role) {
    return (
      <div
        style={{
          ...S.gameContainer,
          background: "#000",
          display: "flex",
          flexDirection: "column",
          justifyContent: "center",
          alignItems: "center",
          padding: 20,
        }}
      >
        <div
          style={{
            color: "#E94560",
            fontSize: 24,
            fontWeight: "bold",
            marginBottom: 40,
          }}
        >
          ВЫБЕРИ РОЛЬ
        </div>
        <div
          style={{
            display: "flex",
            flexDirection: "column",
            gap: 15,
            width: "100%",
          }}
        >
          {Object.values(ROLES).map((r) => (
            <button
              key={r.id}
              onClick={() => selectRole(r.id)}
              style={S.roleCard}
            >
              <div style={{ color: "#fff", fontWeight: "bold" }}>{r.name}</div>
              <div style={{ color: "#E0C068", fontSize: 10 }}>{r.bonus}</div>
              <div style={{ color: "#888", fontSize: 10, marginTop: 5 }}>
                {r.desc}
              </div>
            </button>
          ))}
        </div>
      </div>
    );
  }

  return (
    <div
      style={{
        ...S.gameContainer,
        background: "#000",
        animation: shake ? "shake 0.3s" : "none",
      }}
    >
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');
        body { background: #000; font-family: 'JetBrains Mono', monospace; user-select: none; }
        .hide-scroll::-webkit-scrollbar { display: none; }
        @keyframes glow { 0%, 100% { box-shadow: inset 0 0 5px #ffd700; } 50% { box-shadow: inset 0 0 15px #ffd700; } }
        @keyframes glitchSlow { 0% { opacity: 0.95; } 50% { opacity: 1; } 100% { opacity: 0.95; } }
        @keyframes shake { 0% { transform: translate(1px, 1px) rotate(0deg); } 50% { transform: translate(-1px, 2px) rotate(-1deg); } 100% { transform: translate(1px, -2px) rotate(-1deg); } }
        @keyframes floatUp { 0% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(-30px); opacity: 0; } }
        @keyframes fadeOutUp { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-20px); } }
        @keyframes fall { 0% { transform: translateY(-10px) translateX(0); opacity: 0; } 50% { opacity: 0.5; } 100% { transform: translateY(100vh) translateX(20px); opacity: 0; } }
        @keyframes slideBg { from { background-position: center 0px; } to { background-position: center 50px; } }
        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }
        .crt::before { content: " "; display: block; position: absolute; top: 0; left: 0; bottom: 0; right: 0; background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06)); z-index: 9999; background-size: 100% 2px, 3px 100%; pointer-events: none; }
      `}</style>

      <div
        className="crt"
        style={{
          position: "absolute",
          inset: 0,
          zIndex: 9999,
          pointerEvents: "none",
        }}
      />
      <ParticleSystem />
      <div
        style={{
          position: "absolute",
          inset: 0,
          backgroundImage: `url(${IMG[getZone(floor).img]})`,
          backgroundSize: "cover",
          backgroundPosition: "center",
          filter: `brightness(${Math.max(0.1, 0.5 - floor / 100)})`,
          zIndex: 1,
          animation: phase === "ascending" ? "slideBg 2s ease-in-out" : "none",
        }}
      />

      {/* DAMAGE VIGNETTE */}
      {dmgVignette && (
        <div
          style={{
            position: "absolute",
            inset: 0,
            boxShadow: "inset 0 0 50px red",
            zIndex: 998,
            pointerEvents: "none",
          }}
        />
      )}

      <div
        style={{
          position: "absolute",
          inset: 0,
          pointerEvents: "none",
          zIndex: 999,
          background:
            fxFlash === "red"
              ? "rgba(255,0,0,0.2)"
              : fxFlash === "green"
              ? "rgba(0,255,0,0.1)"
              : "transparent",
        }}
      />

      {/* FLOATING TEXT RENDERER */}
      {floaters.map((f) => (
        <Floater key={f.id} {...f} />
      ))}

      {/* CONTRACTS WIDGET - MOVED DOWN */}
      <div
        style={{
          position: "absolute",
          top: 70,
          left: 20,
          zIndex: 40,
          width: 120,
        }}
      >
        <div style={{ fontSize: 8, color: "#666", marginBottom: 5 }}>
          ЗАДАНИЯ:
        </div>
        {contracts.map((c) => (
          <div
            key={c.id}
            style={{
              fontSize: 9,
              color: "#ccc",
              marginBottom: 3,
              borderLeft: "2px solid #E0C068",
              paddingLeft: 5,
            }}
          >
            • {c.text}
          </div>
        ))}
      </div>

      {!isGlitchActive &&
        !bossData &&
        !activeEvent &&
        !activeRiddle &&
        !incomingCall && (
          <div
            style={{
              position: "absolute",
              top: 20,
              left: 20,
              right: 20,
              zIndex: 40,
              display: "flex",
              justifyContent: "space-between",
            }}
          >
            <div style={{ display: "flex", flexDirection: "column" }}>
              <EnergyPulse
                energy={energy}
                max={max}
                influence={influence}
                cycle={cycle}
              />
              <div style={{ fontSize: 9, color: "#666", marginTop: 4 }}>
                РОЛЬ: {role}
              </div>
            </div>
            {/* CLEAN MAP BUTTON */}
            <div onClick={() => setShowFloors(true)} style={S.floorText}>
              <span style={{ fontSize: 20 }}>🗺️</span>
              <div style={{ fontSize: 9, letterSpacing: 2 }}>КАРТА</div>
            </div>
          </div>
        )}

      {zoneNotification && (
        <div style={S.zonePopup}>
          <div style={{ color: "#E0C068", fontSize: 10, letterSpacing: 2 }}>
            ВХОД В СЕКТОР
          </div>
          <div style={{ color: "#fff", fontSize: 24, fontWeight: "bold" }}>
            {zoneNotification}
          </div>
        </div>
      )}

      {/* MODALS */}
      {/* BAG - HIGH Z-INDEX (3000) FIX */}
      {showBag && (
        <div
          style={S.highOverlay}
          onClick={() => {
            setShowBag(false);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div
              style={{ marginBottom: 20, color: "#E94560", letterSpacing: 2 }}
            >
              СУМКА
            </div>
            {inventory.length === 0 && (
              <div style={{ color: "#666" }}>Пусто...</div>
            )}
            {inventory.map((k, i) => {
              const kData = ITEMS[k] || { name: k, desc: "Предмет" };
              return (
                <button key={i} onClick={() => useItem(k)} style={S.keyItemBtn}>
                  <div>
                    {kData.type === "combat"
                      ? "💣"
                      : kData.type === "key"
                      ? "🔑"
                      : "💊"}{" "}
                    {kData.name}
                  </div>
                  <div style={{ fontSize: 9, color: "#888" }}>{kData.desc}</div>
                </button>
              );
            })}
            <button
              onClick={() => {
                setShowBag(false);
                playSound("click");
              }}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {/* INCOMING CALL SCREEN (NEW) */}
      {incomingCall && (
        <div style={S.bossOverlay}>
          <div
            style={{
              ...S.bossWindow,
              borderColor: "#ffb000",
              background: "#110f00",
            }}
          >
            <div
              style={{
                ...S.bossHeader,
                color: "#ffb000",
                animation: "blink 1s infinite",
              }}
            >
              📞 ВХОДЯЩЕЕ СОЕДИНЕНИЕ...
            </div>
            <div
              style={{
                padding: 20,
                textAlign: "center",
                color: "#cc8800",
                fontFamily: "monospace",
                fontSize: 12,
              }}
            >
              ИСТОЧНИК: <br />
              <span style={{ fontSize: 18, fontWeight: "bold" }}>
                ERNIE_CORE_SYS
              </span>
            </div>
            <button
              onClick={answerCall}
              style={{
                ...S.bossBtn,
                borderColor: "#ffb000",
                color: "#ffb000",
                marginTop: 20,
              }}
            >
              [ ОТВЕТИТЬ ]
            </button>
          </div>
        </div>
      )}

      {/* RIDDLE MODAL (NEW RETRO AMBER THEME) */}
      {activeRiddle && (
        <div style={S.bossOverlay}>
          <div
            style={{
              ...S.bossWindow,
              borderColor: "#ffb000",
              background: "#110f00",
            }}
          >
            <div style={{ ...S.bossHeader, color: "#ffb000" }}>
              ПРОТОКОЛ ЭРНИ
            </div>
            <div
              style={{
                padding: 20,
                textAlign: "center",
                color: "#ffb000",
                fontFamily: "monospace",
                fontSize: 12,
              }}
            >
              {activeRiddle.q}
            </div>
            <div
              style={{
                display: "flex",
                flexDirection: "column",
                gap: 10,
                padding: 10,
              }}
            >
              {activeRiddle.opts.map((opt, i) => (
                <button
                  key={i}
                  onClick={() => handleRiddleAnswer(opt.correct)}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#664400",
                    color: "#ffb000",
                  }}
                >
                  {opt.text}
                </button>
              ))}
            </div>
          </div>
        </div>
      )}

      {showMerchant && (
        <div style={S.bossOverlay}>
          <div style={S.bossWindow}>
            <div style={{ ...S.bossHeader, color: "#00FF00" }}>
              ТОРГОВЫЙ ТЕРМИНАЛ
            </div>
            <div
              style={{
                padding: 10,
                textAlign: "center",
                color: "#ccc",
                fontSize: 10,
                marginBottom: 10,
              }}
            >
              БАЛАНС: {influence} ВЛ
            </div>
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "1fr 1fr",
                gap: 10,
              }}
            >
              <button onClick={() => buyItem("battery", 4)} style={S.shopItem}>
                <div>🔋 БАТАРЕЯ</div>
                <div style={{ color: "#888", fontSize: 8 }}>+40 ЭН</div>
                <div>4 ВЛ</div>
              </button>
              <button onClick={() => buyItem("emp", 6)} style={S.shopItem}>
                <div>💣 ЭМИ</div>
                <div style={{ color: "#888", fontSize: 8 }}>50 УРОН</div>
                <div>6 ВЛ</div>
              </button>
              <button onClick={() => buyItem("stim", 5)} style={S.shopItem}>
                <div>💉 СТИМ</div>
                <div style={{ color: "#888", fontSize: 8 }}>СБРОС РИСКА</div>
                <div>5 ВЛ</div>
              </button>
            </div>
            <button
              onClick={() => setShowMerchant(false)}
              style={S.closeBagBtn}
            >
              УЙТИ
            </button>
          </div>
        </div>
      )}
      {activeEvent && (
        <div style={S.bossOverlay}>
          <div style={S.bossWindow}>
            <div style={{ ...S.bossHeader, color: "#E0C068" }}>
              {activeEvent.title}
            </div>
            <div style={{ padding: 20, textAlign: "center", color: "#ccc" }}>
              {activeEvent.text}
            </div>
            <div
              style={{
                display: "flex",
                flexDirection: "column",
                gap: 10,
                padding: 10,
              }}
            >
              {activeEvent.choices.map((c, i) => (
                <button
                  key={i}
                  onClick={() => handleEventChoice(c.action)}
                  style={S.bossBtn}
                >
                  {c.text}
                </button>
              ))}
            </div>
          </div>
        </div>
      )}
      {bossData && (
        <div style={S.bossOverlay}>
          <div style={S.bossWindow}>
            <div style={S.bossHeader}>⚠️ {bossData.name}</div>
            <div style={S.bossBody}>
              <img
                src={IMG.BOSS_BG}
                style={{
                  width: "100%",
                  height: 100,
                  objectFit: "cover",
                  opacity: 0.7,
                  border: "1px solid #333",
                }}
                alt=""
              />
              <div style={{ marginTop: 10, marginBottom: 5, color: "#fff" }}>
                СТРУКТУРА: {bossData.hp} / {bossData.maxHp}
              </div>
              <div style={{ width: "100%", height: 6, background: "#333" }}>
                <div
                  style={{
                    width: `${(bossData.hp / bossData.maxHp) * 100}%`,
                    height: "100%",
                    background: "red",
                  }}
                />
              </div>
              <div style={S.battleLog}>
                {bossData.log.map((l, i) => (
                  <div key={i}>{l}</div>
                ))}
              </div>
              <div style={{ display: "flex", gap: 10, marginTop: 15 }}>
                <button
                  onClick={() => combatAction("attack")}
                  disabled={energy < 10}
                  style={{ ...S.bossBtn, opacity: energy < 10 ? 0.5 : 1 }}
                >
                  АТАКА (10)
                </button>
                <button
                  onClick={() => combatAction("hack")}
                  disabled={energy < 15}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#00FFFF",
                    color: "#00FFFF",
                    opacity: energy < 15 ? 0.5 : 1,
                  }}
                >
                  ВЗЛОМ (15)
                </button>
              </div>
              <div style={{ display: "flex", gap: 5, marginTop: 10 }}>
                <button
                  onClick={() => setShowBag(true)}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#E0C068",
                    color: "#E0C068",
                    fontSize: 10,
                  }}
                >
                  🎒 ПРЕДМЕТ
                </button>
                <button
                  onClick={() => {
                    setBossData(null);
                    handleDescent();
                  }}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#666",
                    color: "#888",
                    fontSize: 10,
                  }}
                >
                  СБЕЖАТЬ
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
      {isGlitchActive && (
        <div style={S.glitchOverlay}>
          <div style={S.glitchWindow}>
            <div style={S.glitchHeader}>⚠ SYSTEM FAILURE ⚠</div>
            <div style={S.glitchBody}>
              <img
                src={IMG.GHOST_GIF}
                style={{
                  width: "100%",
                  opacity: 0.4,
                  marginBottom: 15,
                  border: "1px solid #111",
                  filter: "grayscale(100%) brightness(20%) contrast(150%)",
                }}
                alt="glitch"
              />
              <div
                style={{
                  color: "#551111",
                  textShadow: "none",
                  fontSize: 14,
                  marginBottom: 10,
                  fontWeight: "bold",
                }}
              >
                ОНО ВИДИТ ТЕБЯ.
              </div>
              <button onClick={handleReboot} style={S.rebootBtn}>
                [ ПЕРЕЗАГРУЗКА ]
              </button>
            </div>
          </div>
        </div>
      )}
      {phase === "emergency" &&
        !isGlitchActive &&
        !bossData &&
        !activeEvent &&
        !activeRiddle &&
        !incomingCall && (
          <div style={S.overlay}>
            <div style={S.box}>
              <div style={{ color: "red", marginBottom: 15 }}>
                КРИТИЧЕСКИЙ СБОЙ
              </div>
              <button onClick={handleDescent} style={S.mainBtn}>
                СПУСК (-5 эт, +30 эн)
              </button>
              <button
                onClick={handleSOS}
                style={{ ...S.mainBtn, marginTop: 10, background: "#00aa44" }}
              >
                {sosLoading ? "..." : "SOS (+100 эн)"}
              </button>
            </div>
          </div>
        )}

      {/* MENUS */}
      {showArchitect && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowArchitect(false);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div
              style={{ marginBottom: 20, color: "#00FFFF", letterSpacing: 2 }}
            >
              СИСТЕМА ЛИФТА
            </div>
            <div style={{ marginBottom: 10, fontSize: 10, color: "#E0C068" }}>
              ВЛИЯНИЕ: {influence}
            </div>
            {UPGRADES.map((u) => {
              const afford = influence >= u.cost;
              return (
                <button
                  key={u.id}
                  onClick={() => buyUpgrade(u)}
                  disabled={!afford}
                  style={{ ...S.keyItemBtn, opacity: afford ? 1 : 0.5 }}
                >
                  <div>
                    <div style={{ color: "#fff", fontWeight: "bold" }}>
                      {u.name}
                    </div>
                    <div style={{ fontSize: 9, color: "#888" }}>{u.effect}</div>
                  </div>
                  <div
                    style={{
                      color: afford ? "#E0C068" : "#444",
                      display: "flex",
                      alignItems: "center",
                      gap: 5,
                    }}
                  >
                    {!afford && "🔒"} {u.cost} ВЛ
                  </div>
                </button>
              );
            })}
            <button
              onClick={() => {
                setShowArchitect(false);
                playSound("click");
              }}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}
      {showRelics && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowRelics(false);
            playSound("click");
          }}
        >
          <div style={S.relicsContainer} onClick={(e) => e.stopPropagation()}>
            <div style={S.relicsGrid}>
              {RELICS_DB.map((r) => {
                const has = relics.includes(r.id);
                return (
                  <div
                    key={r.id}
                    onClick={() => has && setSelectedRelicInfo(r)}
                    style={{
                      ...S.slot,
                      opacity: has ? 1 : 0.1,
                      animation:
                        has && selectedRelicInfo?.id === r.id
                          ? "glow 2s infinite"
                          : "none",
                    }}
                  >
                    {has && <span>{r.icon}</span>}
                  </div>
                );
              })}
            </div>
            <div style={S.relicsTextLayout}>
              <div style={S.panelTitle}>
                {selectedRelicInfo ? selectedRelicInfo.name : "ВЫБЕРИ ПРЕДМЕТ"}
              </div>
              <div style={S.panelEffect}>
                {selectedRelicInfo ? selectedRelicInfo.effect : "..."}
              </div>
              <div style={S.panelLore}>
                {selectedRelicInfo
                  ? selectedRelicInfo.lore
                  : "Предметы хранят память."}
              </div>
            </div>
            <button
              onClick={() => {
                setShowRelics(false);
                playSound("click");
              }}
              style={S.closeBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}
      {showDiary && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowDiary(false);
            setSelectedLog(null);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div style={{ marginBottom: 20, color: "#E0C068" }}>📖 ДНЕВНИК</div>
            {selectedLog ? (
              <div>
                <div
                  style={{
                    color: "#ccc",
                    fontSize: 12,
                    marginBottom: 20,
                    lineHeight: 1.5,
                    textAlign: "left",
                  }}
                >
                  {selectedLog}
                </div>
                <button
                  onClick={() => setSelectedLog(null)}
                  style={S.closeBagBtn}
                >
                  НАЗАД
                </button>
              </div>
            ) : (
              <div style={S.diaryGrid}>
                {[5, 10, 15, 20, 25, 30].map((f) => (
                  <div
                    key={f}
                    onClick={() => floor >= f && setSelectedLog(DIARY_LOGS[f])}
                    style={{
                      ...S.diaryCard,
                      opacity: floor >= f ? 1 : 0.3,
                      cursor: floor >= f ? "pointer" : "default",
                    }}
                  >
                    <div style={{ fontSize: 24 }}>
                      {floor >= f ? "🔓" : "🔒"}
                    </div>
                    <div style={{ fontSize: 10, color: "#666" }}>УР. {f}</div>
                  </div>
                ))}
              </div>
            )}
            {!selectedLog && (
              <button
                onClick={() => {
                  setShowDiary(false);
                  playSound("click");
                }}
                style={S.closeBagBtn}
              >
                ЗАКРЫТЬ
              </button>
            )}
          </div>
        </div>
      )}
      {showFloors && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowFloors(false);
            playSound("click");
          }}
        >
          <div style={S.mapWrapper}>
            <div style={S.mapBg} />
            <div className="hide-scroll" ref={scrollRef} style={S.mapScroll}>
              {[...Array(50)].map((_, i) => {
                const f = 50 - i;
                const isC = floor === f;
                return (
                  <div
                    key={f}
                    style={{
                      ...S.floorCell,
                      color: isC ? "#ffd700" : "#b8860b",
                      opacity: isC ? 1 : 0.4,
                      textShadow: isC ? "0 0 10px #ffd700" : "none",
                    }}
                  >
                    {f}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}
      {showKarmaView && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowKarmaView(false);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div style={{ marginBottom: 20, color: "#E0C068" }}>ТВОЙ ПУТЬ</div>
            <div style={S.karmaCircle}>
              <div
                style={{
                  ...S.karmaNeedle,
                  transform: `translate(-50%, -100%) rotate(${karma * 1.8}deg)`,
                }}
              />
            </div>
            <div
              style={{
                marginTop: 15,
                color: karma > 0 ? "#4a8a4a" : karma < 0 ? "#8a3a6a" : "#ccc",
              }}
            >
              {karma > 0 ? "СВЕТ" : karma < 0 ? "ТЬМА" : "РАВНОВЕСИЕ"}
            </div>
            <button
              onClick={() => {
                setShowKarmaView(false);
                playSound("click");
              }}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {!isGlitchActive &&
        !bossData &&
        !activeEvent &&
        !activeRiddle &&
        !incomingCall && (
          <div style={S.bottomUI}>
            <div style={S.terminal}>
              <div
                style={{ color: "#E94560", fontSize: 8, fontWeight: "bold" }}
              >
                ERNIE
              </div>
              <div style={{ color: "#ccc", fontSize: 12 }}>{displayed}</div>
            </div>
            {done && phase === "floor" && (
              <div
                style={{ display: "flex", flexDirection: "column", gap: 10 }}
              >
                <div
                  style={{
                    display: "flex",
                    gap: 5,
                    justifyContent: "flex-end",
                    opacity: 0.5,
                  }}
                >
                  <button
                    onClick={debugJump}
                    style={{ ...S.debugBtn, color: "#00FFFF" }}
                  >
                    JUMP
                  </button>
                  <button
                    onClick={resetGame}
                    style={{ ...S.debugBtn, color: "red" }}
                  >
                    RESET
                  </button>
                </div>
                <div style={{ display: "flex", gap: 10 }}>
                  <button
                    onClick={() => {
                      setShowBag(true);
                      playSound("click");
                    }}
                    style={S.bagBtn}
                  >
                    СУМКА [{inventory.length}]
                  </button>
                  <button
                    onClick={() => {
                      setShowRelics(true);
                      playSound("click");
                    }}
                    style={S.bagBtn}
                  >
                    РЕЛИКВИИ
                  </button>
                  <button
                    onClick={() => {
                      setShowArchitect(true);
                      playSound("click");
                    }}
                    style={S.bagBtn}
                  >
                    АПГРЕЙД
                  </button>
                </div>
                <div style={{ display: "flex", gap: 10 }}>
                  <button
                    onClick={() => {
                      setShowDiary(true);
                      playSound("click");
                    }}
                    style={S.bagBtn}
                  >
                    ДНЕВНИК
                  </button>
                  <button
                    onClick={() => {
                      setShowKarmaView(true);
                      playSound("click");
                    }}
                    style={{ ...S.bagBtn, position: "relative" }}
                  >
                    КАРМА
                    {karmaFlash && (
                      <div
                        style={{
                          position: "absolute",
                          top: -20,
                          right: 0,
                          color: karmaFlash === "pos" ? "#00FF00" : "#FF0000",
                          fontWeight: "bold",
                          animation: "fadeOutUp 1.5s forwards",
                        }}
                      >
                        {karmaFlash === "pos" ? "+K" : "-K"}
                      </div>
                    )}
                  </button>
                  <button
                    onClick={toggleMute}
                    style={{ ...S.bagBtn, color: muted ? "red" : "#666" }}
                  >
                    {muted ? "🔕" : "🔔"}
                  </button>
                </div>
                <button
                  onClick={ascend}
                  disabled={!canAscend}
                  style={canAscend ? S.mainBtn : S.disBtn}
                >
                  ▲ ПОДЪЁМ
                </button>
                <button
                  onClick={handleRisk}
                  disabled={!canRisk}
                  style={canRisk ? S.subBtn : S.disSub}
                >
                  РИСК ({riskUsedThisCycle}/{maxRiskPerCycle})
                </button>
              </div>
            )}
          </div>
        )}
    </div>
  );
}

