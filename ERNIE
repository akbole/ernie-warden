              УЙТИ
            </button>
          </div>
        </div>
      )}
      {activeEvent && (
        <div style={S.bossOverlay}>
          <div style={S.bossWindow}>
            <div style={{ ...S.bossHeader, color: "#E0C068" }}>
              {activeEvent.title}
            </div>
            <div style={{ padding: 20, textAlign: "center", color: "#ccc" }}>
              {activeEvent.text}
            </div>
            <div
              style={{
                display: "flex",
                flexDirection: "column",
                gap: 10,
                padding: 10,
              }}
            >
              {activeEvent.choices.map((c, i) => (
                <button
                  key={i}
                  onClick={() => handleEventChoice(c.action)}
                  style={S.bossBtn}
                >
                  {c.text}
                </button>
              ))}
            </div>
          </div>
        </div>
      )}
      {bossData && (
        <div style={S.bossOverlay}>
          <div style={S.bossWindow}>
            <div style={S.bossHeader}>⚠️ {bossData.name}</div>
            <div style={S.bossBody}>
              <img
                src={IMG.BOSS_BG}
                style={{
                  width: "100%",
                  height: 100,
                  objectFit: "cover",
                  opacity: 0.7,
                  border: "1px solid #333",
                }}
                alt=""
              />
              <div style={{ marginTop: 10, marginBottom: 5, color: "#fff" }}>
                СТРУКТУРА: {bossData.hp} / {bossData.maxHp}
              </div>
              <div style={{ width: "100%", height: 6, background: "#333" }}>
                <div
                  style={{
                    width: `${(bossData.hp / bossData.maxHp) * 100}%`,
                    height: "100%",
                    background: "#A64444",
                  }}
                />
              </div>
              <div style={S.battleLog}>
                {bossData.log.map((l, i) => (
                  <div key={i}>{l}</div>
                ))}
              </div>
              <div style={{ display: "flex", gap: 10, marginTop: 15 }}>
                <button
                  onClick={() => combatAction("attack")}
                  disabled={energy < 10}
                  style={{ ...S.bossBtn, opacity: energy < 10 ? 0.5 : 1 }}
                >
                  АТАКА (10)
                </button>
                {/* 🎨 UI TWEAK: Muted cyan for hack button */}
                <button
                  onClick={() => combatAction("hack")}
                  disabled={energy < 15}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#44AAAA",
                    color: "#44AAAA",
                    opacity: energy < 15 ? 0.5 : 1,
                  }}
                >
                  ВЗЛОМ (15)
                </button>
              </div>
              <div style={{ display: "flex", gap: 5, marginTop: 10 }}>
                <button
                  onClick={() => setShowBag(true)}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#E0C068",
                    color: "#E0C068",
                    fontSize: 10,
                  }}
                >
                  🎒 ПРЕДМЕТ
                </button>
                <button
                  onClick={() => {
                    setBossData(null);
                    handleDescent();
                  }}
                  style={{
                    ...S.bossBtn,
                    borderColor: "#666",
                    color: "#888",
                    fontSize: 10,
                  }}
                >
                  СБЕЖАТЬ
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
      {isGlitchActive && (
        <div style={S.glitchOverlay}>
          <div style={S.glitchWindow}>
            <div style={S.glitchHeader}>⚠️ SYSTEM FAILURE ⚠</div>
            <div style={S.glitchBody}>
              <img
                src={IMG.GHOST_GIF}
                style={{
                  width: "100%",
                  opacity: 0.4,
                  marginBottom: 15,
                  border: "1px solid #111",
                  filter: "grayscale(100%) brightness(20%) contrast(150%)",
                }}
                alt="glitch"
              />
              <div
                style={{
                  color: "#551111",
                  textShadow: "none",
                  fontSize: 14,
                  marginBottom: 10,
                  fontWeight: "bold",
                }}
              >
                ОНО ВИДИТ ТЕБЯ.
              </div>
              <button onClick={handleReboot} style={S.rebootBtn}>
                [ ПЕРЕЗАГРУЗКА ]
              </button>
            </div>
          </div>
        </div>
      )}
      {phase === "emergency" &&
        !isGlitchActive &&
        !bossData &&
        !activeEvent &&
        !activeRiddle &&
        !incomingCall && (
          <div style={S.overlay}>
            <div style={S.box}>
              <div style={{ color: "red", marginBottom: 15 }}>
                КРИТИЧЕСКИЙ СБОЙ
              </div>
              <button onClick={handleDescent} style={S.mainBtn}>
                СПУСК (-5 эт, +30 эн)
              </button>
              <button
                onClick={handleSOS}
                style={{ ...S.mainBtn, marginTop: 10, background: "#00aa44" }}
              >
                {sosLoading ? "..." : "SOS (+100 эн)"}
              </button>
            </div>
          </div>
        )}

      {showNoLives && (
        <div style={S.overlay}>
          <div
            style={{
              width: "85%",
              background: "#1a1a1a",
              border: "2px solid #8B0000",
              borderRadius: 8,
              padding: 30,
              textAlign: "center",
            }}
          >
            <div style={{ fontSize: 48, marginBottom: 20 }}>💀</div>
            <div
              style={{
                fontSize: 18,
                color: "#E94560",
                fontWeight: "bold",
                marginBottom: 15,
              }}
            >
              БАШНЯ ЗАКРЫТА
            </div>
            <div style={{ fontSize: 12, color: "#ccc", marginBottom: 20 }}>
              У тебя закончились жизни.
            </div>
            <div style={{ marginBottom: 25 }}>
              <div style={{ fontSize: 10, color: "#666", marginBottom: 8 }}>
                Следующая жизнь через:
              </div>
              <LivesTimer />
            </div>
            <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
              <button
                style={{
                  background:
                    "linear-gradient(135deg, rgba(233,69,96,0.3), rgba(233,69,96,0.5))",
                  border: "2px solid #E94560",
                  color: "#E94560",
                  padding: 15,
                  fontSize: 12,
                  cursor: "pointer",
                  fontWeight: "bold",
                }}
              >
                ⭐ ПРОДОЛЖИТЬ (1 Star)
                <div
                  style={{
                    fontSize: 9,
                    color: "#999",
                    marginTop: 5,
                    fontWeight: "normal",
                  }}
                >
                  Telegram Stars (скоро)
                </div>
              </button>
              <button
                onClick={() => setShowNoLives(false)}
                style={{
                  background: "transparent",
                  border: "1px solid #444",
                  color: "#888",
                  padding: 12,
                  fontSize: 11,
                  cursor: "pointer",
                }}
              >
                ЗАКРЫТЬ
              </button>
            </div>
          </div>
        </div>
      )}

      {showArchitect && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowArchitect(false);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div
              style={{ marginBottom: 20, color: "#00FFFF", letterSpacing: 2 }}
            >
              СИСТЕМА ЛИФТА
            </div>
            <div style={{ marginBottom: 10, fontSize: 10, color: "#E0C068" }}>
              ВЛИЯНИЕ: {influence}
            </div>
            {UPGRADES.map((u) => {
              const afford = influence >= u.cost;
              return (
                <button
                  key={u.id}
                  onClick={() => buyUpgrade(u)}
                  disabled={!afford}
                  style={{ ...S.keyItemBtn, opacity: afford ? 1 : 0.5 }}
                >
                  <div>
                    <div style={{ color: "#fff", fontWeight: "bold" }}>
                      {u.name}
                    </div>
                    <div style={{ fontSize: 9, color: "#888" }}>{u.effect}</div>
                  </div>
                  <div
                    style={{
                      color: afford ? "#E0C068" : "#444",
                      display: "flex",
                      alignItems: "center",
                      gap: 5,
                    }}
                  >
                    {!afford && "🔒"} {u.cost} ВЛ
                  </div>
                </button>
              );
            })}
            <button
              onClick={() => {
                setShowArchitect(false);
                playSound("click");
              }}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}
      {showRelics && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowRelics(false);
            playSound("click");
          }}
        >
          <div style={S.relicsContainer} onClick={(e) => e.stopPropagation()}>
            <div style={S.relicsGrid}>
              {RELICS_DB.map((r) => {
                const has = relics.includes(r.id);
                return (
                  <div
                    key={r.id}
                    onClick={() => has && setSelectedRelicInfo(r)}
                    style={{
                      ...S.slot,
                      opacity: has ? 1 : 0.1,
                      animation:
                        has && selectedRelicInfo?.id === r.id
                          ? "glow 2s infinite"
                          : "none",
                    }}
                  >
                    {has && <span>{r.icon}</span>}
                  </div>
                );
              })}
            </div>
            <div style={S.relicsTextLayout}>
              <div style={S.panelTitle}>
                {selectedRelicInfo ? selectedRelicInfo.name : "ВЫБЕРИ ПРЕДМЕТ"}
              </div>
              <div style={S.panelEffect}>
                {selectedRelicInfo ? selectedRelicInfo.effect : "..."}
              </div>
              <div style={S.panelLore}>
                {selectedRelicInfo
                  ? selectedRelicInfo.lore
                  : "Предметы хранят память."}
              </div>
            </div>
            <button
              onClick={() => {
                setShowRelics(false);
                playSound("click");
              }}
              style={S.closeBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}
      {showDiary && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowDiary(false);
            setSelectedLog(null);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div style={{ marginBottom: 20, color: "#E0C068" }}>📖 ДНЕВНИК</div>
            {selectedLog ? (
              <div>
                <div
                  style={{
                    color: "#ccc",
                    fontSize: 12,
                    marginBottom: 20,
                    lineHeight: 1.5,
                    textAlign: "left",
                  }}
                >
                  {selectedLog}
                </div>
                <button
                  onClick={() => setSelectedLog(null)}
                  style={S.closeBagBtn}
                >
                  НАЗАД
                </button>
              </div>
            ) : (
              <div style={S.diaryGrid}>
                {[5, 10, 15, 20, 25, 30].map((f) => (
                  <div
                    key={f}
                    onClick={() => floor >= f && setSelectedLog(DIARY_LOGS[f])}
                    style={{
                      ...S.diaryCard,
                      opacity: floor >= f ? 1 : 0.3,
                      cursor: floor >= f ? "pointer" : "default",
                    }}
                  >
                    <div style={{ fontSize: 24 }}>
                      {floor >= f ? "🔓" : "🔒"}
                    </div>
                    <div style={{ fontSize: 10, color: "#666" }}>УР. {f}</div>
                  </div>
                ))}
              </div>
            )}
            {!selectedLog && (
              <button
                onClick={() => {
                  setShowDiary(false);
                  playSound("click");
                }}
                style={S.closeBagBtn}
              >
                ЗАКРЫТЬ
              </button>
            )}
          </div>
        </div>
      )}
      {showFloors && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowFloors(false);
            playSound("click");
          }}
        >
          <div style={S.mapWrapper}>
            <div style={S.mapBg} />
            <div className="hide-scroll" ref={scrollRef} style={S.mapScroll}>
              {[...Array(50)].map((_, i) => {
                const f = 50 - i;
                const isC = floor === f;
                return (
                  <div
                    key={f}
                    style={{
                      ...S.floorCell,
                      color: isC ? "#ffd700" : "#b8860b",
                      opacity: isC ? 1 : 0.4,
                      textShadow: isC ? "0 0 10px #ffd700" : "none",
                    }}
                  >
                    {f}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}
      {showKarmaView && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowKarmaView(false);
            playSound("click");
          }}
        >
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div style={{ marginBottom: 20, color: "#E0C068" }}>ТВОЙ ПУТЬ</div>
            <div style={S.karmaCircle}>
              <div
                style={{
                  ...S.karmaNeedle,
                  transform: `translate(-50%, -100%) rotate(${karma * 1.8}deg)`,
                }}
              />
            </div>
            <div
              style={{
                marginTop: 15,
                color: karma > 0 ? "#4a8a4a" : karma < 0 ? "#8a3a6a" : "#ccc",
              }}
            >
              {karma > 0 ? "СВЕТ" : karma < 0 ? "ТЬМА" : "РАВНОВЕСИЕ"}
            </div>
            <button
              onClick={() => {
                setShowKarmaView(false);
                playSound("click");
              }}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {showMenu && (
        <div
          style={S.overlay}
          onClick={() => {
            setShowMenu(false);
            playSound("click");
          }}
        >
          <div style={S.menuContainer} onClick={(e) => e.stopPropagation()}>
            <div style={S.menuHeader}>📍 МЕНЮ</div>
            <div style={S.menuGrid}>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowBag(true);
                }}
                style={S.menuItem}
              >
                🎒 СУМКА <div style={S.menuBadge}>{inventory.length}</div>
              </button>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowCardCollection(true);
                }}
                style={S.menuItem}
              >
                🃏 КАРТЫ <div style={S.menuBadge}>{playerCards.length}/7</div>
              </button>
              {/* 🔧 FIX: Relics button now correctly opens the relics screen */}
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowRelics(true);
                }}
                style={S.menuItem}
              >
                🏆 РЕЛИКВИИ <div style={S.menuBadge}>{relics.length}/6</div>
              </button>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowArchitect(true);
                }}
                style={S.menuItem}
              >
                ⚙️ АПГРЕЙД <div style={S.menuBadge}>{influence}</div>
              </button>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowDiary(true);
                }}
                style={S.menuItem}
              >
                📖 ДНЕВНИК{" "}
                <div style={S.menuBadge}>
                  {Object.keys(DIARY_LOGS).filter((f) => floor >= f).length}/6
                </div>
              </button>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowKarmaView(true);
                }}
                style={S.menuItem}
              >
                ⚖️ КАРМА{" "}
                <div style={S.menuBadge}>
                  {karma > 0 ? "+" : ""}
                  {karma}
                </div>
              </button>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowAchievements(true);
                }}
                style={S.menuItem}
              >
                🏅 НАГРАДЫ{" "}
                <div style={S.menuBadge}>
                  {achievements.length}/{ACHIEVEMENTS_DB.length}
                </div>
              </button>
              <button
                onClick={() => {
                  setShowMenu(false);
                  setShowFloors(true);
                }}
                style={S.menuItem}
              >
                🗺️ КАРТА <div style={S.menuBadge}>{floor}/50</div>
              </button>
              <button
                onClick={() => {
                  toggleMute();
                }}
                style={S.menuItem}
              >
                {muted ? "🔕" : "🔔"} ЗВУК{" "}
                <div style={S.menuBadge}>{muted ? "ВЫКЛ" : "ВКЛ"}</div>
              </button>
              <div
                style={{
                  gridColumn: "1 / -1",
                  borderTop: "1px solid #333",
                  paddingTop: 10,
                  marginTop: 5,
                }}
              >
                <div style={{ fontSize: 8, color: "#666", marginBottom: 8 }}>
                  ЗАДАНИЯ:
                </div>
                {contracts.map((c) => (
                  <div
                    key={c.id}
                    style={{
                      fontSize: 9,
                      color: "#ccc",
                      marginBottom: 5,
                      borderLeft: "2px solid #E0C068",
                      paddingLeft: 8,
                    }}
                  >
                    • {c.text}
                  </div>
                ))}
              </div>
            </div>
            <button
              onClick={() => {
                setShowMenu(false);
                playSound("click");
              }}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {!isGlitchActive &&
        !bossData &&
        !activeEvent &&
        !activeRiddle &&
        !incomingCall &&
        !isIntroActive && (
          <div style={S.bottomUI}>
            <div
              style={{
                background: ernieExpanded
                  ? "rgba(0,0,0,0.85)"
                  : "rgba(0,0,0,0.6)",
                padding: ernieExpanded ? 20 : 12,
                border: "2px solid #E94560",
                borderLeft: "4px solid #E94560",
                marginBottom: 15,
                minHeight: ernieExpanded ? 100 : 50,
                transition: "all 0.3s ease",
                position: "relative",
                animation: ernieExpanded
                  ? "ernieSlideIn 0.3s ease-out"
                  : "none",
              }}
            >
              <div
                style={{
                  color: "#E94560",
                  fontSize: 8,
                  fontWeight: "bold",
                  marginBottom: ernieExpanded ? 8 : 4,
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                }}
              >
                <span>ERNIE</span>
                <span style={{ color: MOOD_COLORS[mood], fontSize: 7 }}>
                  {mood.toUpperCase()}
                </span>
              </div>
              <div
                style={{
                  color: "#ccc",
                  fontSize: ernieExpanded ? 12 : 10,
                  lineHeight: ernieExpanded ? 1.4 : 1.2,
                }}
              >
                {displayed}
              </div>
              {done && ernieExpanded && (
                <div
                  onClick={() => setErnieExpanded(false)}
                  style={{
                    position: "absolute",
                    bottom: 5,
                    right: 10,
                    fontSize: 8,
                    color: "#666",
                    cursor: "pointer",
                  }}
                >
                  [свернуть]
                </div>
              )}
            </div>
            {done && phase === "floor" && (
              <div
                style={{ display: "flex", flexDirection: "column", gap: 10 }}
              >
                <div
                  style={{
                    display: "flex",
                    gap: 5,
                    justifyContent: "flex-end",
                    opacity: 0.3,
                  }}
                >
                  <button
                    onClick={debugJump}
                    style={{
                      background: "none",
                      border: "none",
                      color: "#00FFFF",
                      fontSize: 8,
                      cursor: "pointer",
                    }}
                  >
                    JUMP
                  </button>
                  <button
                    onClick={resetGame}
                    style={{
                      background: "none",
                      border: "none",
                      color: "red",
                      fontSize: 8,
                      cursor: "pointer",
                    }}
                  >
                    RESET
                  </button>
                </div>
                <button
                  onClick={() => {
                    setErnieExpanded(true);
                    ascend();
                  }}
                  disabled={!canAscend}
                  style={{
                    width: "100%",
                    padding: canAscend ? 24 : 16,
                    background: canAscend
                      ? "linear-gradient(135deg, rgba(166,68,68,0.3), rgba(233,69,96,0.5))"
                      : "transparent",
                    border: canAscend ? "2px solid #E94560" : "2px solid #333",
                    color: canAscend ? "#E94560" : "#333",
                    fontWeight: "bold",
                    fontSize: canAscend ? 18 : 14,
                    letterSpacing: 2,
                    cursor: canAscend ? "pointer" : "not-allowed",
                    boxShadow: canAscend
                      ? "0 0 20px rgba(233,69,96,0.3)"
                      : "none",
                    transition: "all 0.3s ease",
                    textShadow: canAscend ? "0 0 10px #E94560" : "none",
                  }}
                >
                  {canAscend ? "▲ ПОДЪЁМ" : "✗ НЕТ ЭНЕРГИИ"}
                </button>
                <button
                  onClick={handleRisk}
                  disabled={!canRisk}
                  style={{
                    width: "100%",
                    padding: 10,
                    background: "transparent",
                    border: canRisk ? "1px solid #666" : "1px solid #222",
                    color: canRisk ? "#999" : "#222",
                    fontSize: 10,
                    cursor: canRisk ? "pointer" : "not-allowed",
                    opacity: canRisk ? 1 : 0.3,
                  }}
                >
                  РИСК ({riskUsedThisCycle}/{maxRiskPerCycle})
                </button>
              </div>
            )}
          </div>
        )}

      {/* --- PATCH v220: ENDING RENDERING --- */}
      {showEnding && endingType === "light" && <LightEnding />}
      {showEnding && endingType === "gray" && <GrayEnding />}
      {showEnding && endingType === "dark" && <DarkEnding />}
    </div>
  );
}

const S = {
  gameContainer: {
    width: "100%",
    maxWidth: 420,
    margin: "0 auto",
    height: "100dvh",
    position: "relative",
