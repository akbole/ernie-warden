/* --- HOOKS --- */
function useTypewriter(fullText, speed = 35) {
  const [displayed, setDisplayed] = useState("");
  const [done, setDone] = useState(false);
  const ref = useRef(null);

  useEffect(() => {
    setDisplayed("");
    setDone(false);
    let i = 0;
    clearInterval(ref.current);
    if (!fullText) return;
    ref.current = setInterval(() => {
      i++;
      setDisplayed(fullText.slice(0, i));
      if (i >= fullText.length) {
        clearInterval(ref.current);
        setTimeout(() => setDone(true), 300);
      }
    }, speed);
    return () => clearInterval(ref.current);
  }, [fullText, speed]);

  return { displayed, done };
}

/* --- COMPONENTS --- */
function EnergyPulse({ energy, max, isInsight }) {
  const pct = Math.max(0, Math.min(1, energy / max));
  const isCritical = pct < 0.2;
  const color = isInsight
    ? "#00FFFF"
    : isCritical
    ? "#FF0000"
    : pct < 0.5
    ? "#E94560"
    : "#666";
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
      <span
        style={{
          fontSize: 11,
          color: color,
          textShadow: isInsight ? "0 0 5px #00FFFF" : "none",
        }}
      >
        ⚡
      </span>
      <div
        style={{
          width: 60,
          height: 4,
          background: "rgba(255,255,255,0.1)",
          borderRadius: 2,
        }}
      >
        <div
          style={{
            width: `${pct * 100}%`,
            height: "100%",
            background: color,
            transition: "width 0.6s ease",
          }}
        />
      </div>
    </div>
  );
}

function FloorStack({ floor, zoneLabel, zoneColor, isGlitching }) {
  return (
    <div style={{ textAlign: "right" }}>
      <div
        style={{
          fontSize: 36,
          fontWeight: 800,
          color: "#e0e0e0",
          fontFamily: "'JetBrains Mono', monospace",
          lineHeight: 1,
        }}
      >
        {isGlitching ? Math.floor(Math.random() * 99) : floor}
      </div>
      <div
        style={{
          fontSize: 10,
          letterSpacing: 2,
          color: "#AAAAAA",
          fontWeight: "bold",
        }}
      >
        ЭТАЖ
      </div>
      <div
        style={{
          fontSize: 10,
