   function KarmaAura(props) {
     var karma = props.karma;
     var onClick = props.onClick;
     var color = getKarmaColor(karma);
     var glowSize = (Math.abs(karma) / 100) * 8 + 4;
     return (
       <div
         onClick={onClick}
         style={{
           width: 52,
           height: 52,
           borderRadius: "50%",
           cursor: "pointer",
           position: "relative",
           display: "flex",
           alignItems: "center",
           justifyContent: "center",
         }}
       >
         <div
           style={{
             position: "absolute",
             top: -4,
             left: -4,
             right: -4,
             bottom: -4,
             borderRadius: "50%",
             border: "2px solid " + color,
             boxShadow:
               "0 0 " +
               glowSize +
               "px " +
               color +
               "80, 0 0 " +
               glowSize * 2 +
               "px " +
               color +
               "30",
             animation: "karmaAuraPulse 2.5s ease-in-out infinite",
             transition: "all 1.5s ease",
           }}
         />
         <div
           style={{
             width: 40,
             height: 40,
             borderRadius: "50%",
             background:
               "radial-gradient(circle, " + color + "15, rgba(0,0,0,0.6))",
             border: "1px solid " + color + "60",
             display: "flex",
             alignItems: "center",
             justifyContent: "center",
             fontSize: 18,
             color: color,
             transition: "all 1s ease",
           }}
         >
           ☉
         </div>
       </div>
     );
   }
   
   function EnergyPulse(props) {
     var energy = props.energy;
     var max = props.max;
     var pct = energy / max;
     return (
       <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
         <span style={{ fontSize: 11, color: pct < 0.3 ? "#E94560" : "#666" }}>
           ⚡
         </span>
         <div
           style={{
             width: 60,
             height: 4,
             background: "rgba(255,255,255,0.1)",
             borderRadius: 2,
           }}
         >
           <div
             style={{
               width: pct * 100 + "%",
               height: "100%",
               background: pct < 0.3 ? "#E94560" : "#777",
               transition: "width 0.6s ease",
             }}
           />
         </div>
       </div>
     );
   }
   
