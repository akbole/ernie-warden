function useTypewriter(fullText, speed = 35) {
  const [displayed, setDisplayed] = useState("");
  const [done, setDone] = useState(false);
  const ref = useRef(null);
  useEffect(() => {
    setDisplayed("");
    setDone(false);
    let i = 0;
    clearInterval(ref.current);
    if (!fullText) return;
    ref.current = setInterval(() => {
      i++;
      setDisplayed(fullText.slice(0, i));
      if (i >= fullText.length) {
        clearInterval(ref.current);
        setTimeout(() => setDone(true), 300);
      }
    }, speed);
    return () => clearInterval(ref.current);
  }, [fullText, speed]);
  return { displayed, done };
}

function EnergyPulse({ energy, max, karma }) {
  const pct = Math.max(0, Math.min(1, energy / max));
  let color = pct < 0.2 ? "#FF0000" : pct < 0.5 ? "#E94560" : "#666";
  if (karma > 30) color = "#4a8a4a"; // Green for good karma
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
      <span style={{ fontSize: 11, color }}>⚡</span>
      <div
        style={{
          width: 80,
          height: 6,
          background: "rgba(255,255,255,0.1)",
          borderRadius: 3,
        }}
      >
        <div
          style={{
            width: `${pct * 100}%`,
            height: "100%",
            background: color,
            transition: "width 0.6s ease",
            borderRadius: 3,
          }}
        />
      </div>
      <span style={{ fontSize: 10, color: "#888" }}>{Math.floor(energy)}</span>
    </div>
  );
}

export default function ErnieGame() {
  // --- STATE ---
  const [floor, setFloor] = useState(
    () => Number(localStorage.getItem("ernie_floor")) || 1
  );
  const [energy, setEnergy] = useState(
    () => Number(localStorage.getItem("ernie_energy")) || 100
  );
  const [relics, setRelics] = useState(
    () => JSON.parse(localStorage.getItem("ernie_relics")) || []
  );
  const [inventory, setInventory] = useState(
    () => JSON.parse(localStorage.getItem("ernie_inventory")) || ["silence"]
  );
  const [karma, setKarma] = useState(
    () => Number(localStorage.getItem("ernie_karma")) || 0
  );
  const [riskUsedThisCycle, setRiskUsedThisCycle] = useState(
    () => Number(localStorage.getItem("ernie_risk_cycle")) || 0
  );

  // UI State
  const [phase, setPhase] = useState("floor");
  const [currentText, setCurrentText] = useState("");

  // Modals
  const [showRelics, setShowRelics] = useState(false);
  const [showBag, setShowBag] = useState(false);
  const [showDiary, setShowDiary] = useState(false);
  const [showKarmaView, setShowKarmaView] = useState(false);
  const [showFloors, setShowFloors] = useState(false);

  const [selectedRelicInfo, setSelectedRelicInfo] = useState(null);
  const [sosLoading, setSosLoading] = useState(false);
  const [trialResult, setTrialResult] = useState(null);
  const [fxFlash, setFxFlash] = useState(null);

  const scrollRef = useRef(null);
  const { displayed, done } = useTypewriter(
    currentText,
    phase === "ascending" ? 80 : 35
  );

  const getZone = (f) => {
    if (f <= 10) return { img: "CABIN" };
    if (f <= 20) return { img: "LAB" };
    if (f <= 30) return { img: "LOFT" };
    if (f <= 40) return { img: "GARDEN" };
    return { img: "OFFICE" };
  };

  // --- STATS ---
  let maxEnergyMult = 1;
  let costReduction = 0;
  let maxRiskPerCycle = 2;
  relics.forEach((rid) => {
    const r = RELICS_DB.find((x) => x.id === rid);
    if (r?.bonus?.maxEnergy) maxEnergyMult *= r.bonus.maxEnergy;
    if (r?.bonus?.costReduc) costReduction += r.bonus.costReduc;
    if (r?.bonus?.extraRisk) maxRiskPerCycle += r.bonus.extraRisk;
  });

  const max = Math.floor(
    (floor <= 10 ? 100 : floor <= 30 ? 140 : 220) * maxEnergyMult
  );
  const cost = Math.max(
    10,
    (floor <= 10 ? 30 : floor <= 30 ? 45 : 65) - costReduction
  );
  const canAscend = energy >= cost && phase !== "emergency";
  const canRisk = energy >= 20 && riskUsedThisCycle < maxRiskPerCycle;

  // --- ACTIONS ---
  const triggerFlash = (type) => {
    setFxFlash(type);
    setTimeout(() => setFxFlash(null), 300);
  };

  const useKey = (keyId) => {
    setInventory((prev) => {
      const idx = prev.indexOf(keyId);
      if (idx > -1) {
        const n = [...prev];
        n.splice(idx, 1);
        return n;
      }
      return prev;
    });
    setTrialResult(`ИСПОЛЬЗОВАНО: ${KEYS[keyId]?.name || keyId}`);
    setShowBag(false);
  };

  const handleRisk = () => {
    if (!canRisk) return;
    setEnergy((e) => Math.max(0, e - 20));
    setRiskUsedThisCycle((c) => c + 1);
    if (Math.random() > 0.5) {
      setEnergy((e) => Math.min(e + 45, max));
      setTrialResult("УДАЧА! +45");
      triggerFlash("green");
    } else {
      setTrialResult("ПУСТОТА...");
      triggerFlash("red");
    }
  };

  const ascend = () => {
    if (!canAscend) return;
    setPhase("ascending");
    setEnergy((e) => e - cost);
    setTrialResult(null);
    setRiskUsedThisCycle(0);
    setTimeout(() => {
      setFloor((f) => Math.min(f + 1, 50));
      setPhase("floor");
    }, 2000);
  };

  const handleDescent = () => {
    setFloor((f) => Math.max(1, f - 5));
    setEnergy(30);
    setPhase("floor");
    setTrialResult("АВАРИЙНЫЙ СПУСК.");
  };
  const handleSOS = () => {
    setSosLoading(true);
    setTimeout(() => {
      setFloor((f) => Math.max(1, f - 5));
      setEnergy(100);
      setPhase("floor");
      setSosLoading(false);
    }, 2000);
  };

  // --- DEBUG TOOLS ---
  const debugAddAllRelics = () => setRelics(RELICS_DB.map((r) => r.id));
  const debugAddKey = () => setInventory((p) => [...p, "mirror"]);

  // --- EFFECTS ---
  useEffect(() => {
    if (energy <= 0 && phase !== "emergency") {
      setPhase("emergency");
      triggerFlash("red");
    }
  }, [energy, phase]);

  useEffect(() => {
    localStorage.setItem("ernie_floor", floor);
    localStorage.setItem("ernie_energy", energy);
    localStorage.setItem("ernie_relics", JSON.stringify(relics));
    localStorage.setItem("ernie_inventory", JSON.stringify(inventory));
    localStorage.setItem("ernie_risk_cycle", riskUsedThisCycle);
  }, [floor, energy, relics, inventory, riskUsedThisCycle]);

  useEffect(() => {
    let txt =
      phase === "emergency"
        ? "СБОЙ СИСТЕМЫ. ЭНЕРГИЯ 0."
        : trialResult ||
          (floor === 1 ? "Этаж 0. Лифт ждет." : "Ты слышишь гул механизмов.");
    setCurrentText(txt);
  }, [floor, trialResult, phase]);

  useEffect(() => {
    if (showFloors && scrollRef.current)
      scrollRef.current.scrollTo({
        top: (50 - floor) * 30 - 100,
        behavior: "auto",
      });
  }, [showFloors, floor]);

  return (
    <div style={{ ...S.gameContainer, background: "#000" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');
        body { background: #000; font-family: 'JetBrains Mono', monospace; user-select: none; }
        .hide-scroll::-webkit-scrollbar { display: none; }
        @keyframes glow { 0%, 100% { box-shadow: inset 0 0 5px #ffd700; } 50% { box-shadow: inset 0 0 15px #ffd700; } }
      `}</style>

      {/* BACKGROUND */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          backgroundImage: `url(${IMG[getZone(floor).img]})`,
          backgroundSize: "cover",
          backgroundPosition: "center",
          filter: "brightness(0.4)",
          zIndex: 1,
        }}
      />
      <div
        style={{
          position: "absolute",
          inset: 0,
          pointerEvents: "none",
          zIndex: 999,
          background:
            fxFlash === "red"
              ? "rgba(255,0,0,0.2)"
              : fxFlash === "green"
              ? "rgba(0,255,0,0.1)"
              : "transparent",
        }}
      />

      {/* HUD */}
      <div
        style={{
          position: "absolute",
          top: 20,
          left: 20,
          right: 20,
          zIndex: 40,
          display: "flex",
          justifyContent: "space-between",
        }}
      >
        <EnergyPulse energy={energy} max={max} karma={karma} />
        <div onClick={() => setShowFloors(true)} style={S.floorText}>
          {floor}
          <div style={{ fontSize: 9, letterSpacing: 2 }}>ЭТАЖ</div>
        </div>
      </div>

      {/* EMERGENCY */}
      {phase === "emergency" && (
        <div style={S.overlay}>
          <div style={S.box}>
            <div style={{ color: "red", marginBottom: 15 }}>
              КРИТИЧЕСКИЙ СБОЙ
            </div>
            <button onClick={handleDescent} style={S.mainBtn}>
              СПУСК (-5 эт, +30 эн)
            </button>
            <button
              onClick={handleSOS}
              style={{ ...S.mainBtn, marginTop: 10, background: "#00aa44" }}
            >
              {sosLoading ? "..." : "SOS (+100 эн)"}
            </button>
          </div>
        </div>
      )}

      {/* MODAL: СУМКА (СТАРЫЙ ДИЗАЙН) */}
      {showBag && (
        <div style={S.overlay} onClick={() => setShowBag(false)}>
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div
              style={{ marginBottom: 20, color: "#E94560", letterSpacing: 2 }}
            >
              СУМКА
            </div>
            {inventory.length === 0 && (
              <div style={{ color: "#666" }}>Пусто...</div>
            )}
            {inventory.map((k, i) => {
              const kData = KEYS[k] || { name: k, desc: "Предмет" };
              return (
                <button key={i} onClick={() => useKey(k)} style={S.keyItemBtn}>
                  <div>
                    {kData.icon} {kData.name}
                  </div>
                  <div style={{ fontSize: 9, color: "#888" }}>{kData.desc}</div>
                </button>
              );
            })}
            <button onClick={() => setShowBag(false)} style={S.closeBagBtn}>
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {/* MODAL: ДНЕВНИК (СТАРЫЙ ДИЗАЙН С ЗАМКАМИ) */}
      {showDiary && (
        <div style={S.overlay} onClick={() => setShowDiary(false)}>
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div style={{ marginBottom: 20, color: "#E0C068" }}>📖 ДНЕВНИК</div>
            <div style={S.diaryGrid}>
              {[5, 10, 15, 20, 25, 30].map((f) => (
                <div key={f} style={S.diaryCard}>
                  <div style={{ fontSize: 24 }}>{floor >= f ? "🔓" : "🔒"}</div>
                  <div style={{ fontSize: 10, color: "#666" }}>???</div>
                </div>
              ))}
            </div>
            <button onClick={() => setShowDiary(false)} style={S.closeBagBtn}>
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {/* MODAL: КАРМА (СТАРЫЙ КРУГЛЫЙ ДИЗАЙН) */}
      {showKarmaView && (
        <div style={S.overlay} onClick={() => setShowKarmaView(false)}>
          <div style={S.bagContent} onClick={(e) => e.stopPropagation()}>
            <div style={{ marginBottom: 20, color: "#E0C068" }}>ТВОЙ ПУТЬ</div>
            <div style={S.karmaCircle}>
              <div
                style={{
                  ...S.karmaNeedle,
                  transform: `translate(-50%, -100%) rotate(${karma * 1.8}deg)`,
                }}
              />
            </div>
            <div
              style={{
                marginTop: 15,
                color: karma > 0 ? "#4a8a4a" : karma < 0 ? "#8a3a6a" : "#ccc",
              }}
            >
              {karma > 0 ? "СВЕТ" : karma < 0 ? "ТЬМА" : "РАВНОВЕСИЕ"}
            </div>
            <button
              onClick={() => setShowKarmaView(false)}
              style={S.closeBagBtn}
            >
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {/* MODAL: РЕЛИКВИИ (НОВЫЙ КРАСИВЫЙ ДИЗАЙН) */}
      {showRelics && (
        <div style={S.overlay} onClick={() => setShowRelics(false)}>
          <div style={S.relicsContainer} onClick={(e) => e.stopPropagation()}>
            <div style={S.relicsGrid}>
              {RELICS_DB.map((r) => {
                const has = relics.includes(r.id);
                return (
                  <div
                    key={r.id}
                    onClick={() => has && setSelectedRelicInfo(r)}
                    style={{
                      ...S.slot,
                      opacity: has ? 1 : 0.1,
                      animation:
                        has && selectedRelicInfo?.id === r.id
                          ? "glow 2s infinite"
                          : "none",
                    }}
                  >
                    {has && <span>{r.icon}</span>}
                  </div>
                );
              })}
            </div>
            <div style={S.relicsTextLayout}>
              <div style={S.panelTitle}>
                {selectedRelicInfo ? selectedRelicInfo.name : "ВЫБЕРИ ПРЕДМЕТ"}
              </div>
              <div style={S.panelEffect}>
                {selectedRelicInfo ? selectedRelicInfo.effect : "..."}
              </div>
              <div style={S.panelLore}>
                {selectedRelicInfo
                  ? selectedRelicInfo.lore
                  : "Предметы хранят память."}
              </div>
            </div>
            <button onClick={() => setShowRelics(false)} style={S.closeBtn}>
              ЗАКРЫТЬ
            </button>
          </div>
        </div>
      )}

      {/* MODAL: КАРТА (СТАРЫЙ СТАТИЧНЫЙ ФОН) */}
      {showFloors && (
        <div style={S.overlay} onClick={() => setShowFloors(false)}>
          <div style={S.mapWrapper}>
            {/* Картинка одна на весь скролл, зафиксирована */}
            <div style={S.mapBg} />
            <div className="hide-scroll" ref={scrollRef} style={S.mapScroll}>
              {[...Array(50)].map((_, i) => {
                const f = 50 - i;
                const isC = floor === f;
                return (
                  <div
                    key={f}
                    style={{
                      ...S.floorCell,
                      color: isC ? "#ffd700" : "#b8860b",
                      opacity: isC ? 1 : 0.4,
                      textShadow: isC ? "0 0 10px #ffd700" : "none",
                    }}
                  >
                    {f}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* BOTTOM UI (ВОЗВРАЩЕНЫ ВСЕ КНОПКИ) */}
      <div style={S.bottomUI}>
        <div style={S.terminal}>
          <div style={{ color: "#E94560", fontSize: 8, fontWeight: "bold" }}>
            ERNIE
          </div>
          <div style={{ color: "#ccc", fontSize: 12 }}>{displayed}</div>
        </div>

        {done && phase === "floor" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            {/* DEBUG LINE */}
            <div
              style={{
                display: "flex",
                gap: 5,
                justifyContent: "flex-end",
                opacity: 0.5,
              }}
            >
              <button
                onClick={debugAddAllRelics}
                style={{
                  background: "none",
                  border: "none",
                  color: "#444",
                  fontSize: 8,
                }}
              >
                DEBUG: ALL
              </button>
              <button
                onClick={debugAddKey}
                style={{
                  background: "none",
                  border: "none",
                  color: "#444",
                  fontSize: 8,
                }}
              >
                +KEY
              </button>
            </div>

            <div style={{ display: "flex", gap: 10 }}>
              <button onClick={() => setShowBag(true)} style={S.bagBtn}>
                СУМКА [{inventory.length}]
              </button>
              <button onClick={() => setShowRelics(true)} style={S.bagBtn}>
                РЕЛИКВИИ
              </button>
              <button onClick={() => setShowDiary(true)} style={S.bagBtn}>
                ДНЕВНИК
              </button>
              <button onClick={() => setShowKarmaView(true)} style={S.bagBtn}>
                КАРМА
              </button>
            </div>

            <button
              onClick={ascend}
              disabled={!canAscend}
              style={canAscend ? S.mainBtn : S.disBtn}
            >
              ▲ ПОДЪЁМ
            </button>
            <button
              onClick={handleRisk}
              disabled={!canRisk}
              style={canRisk ? S.subBtn : S.disSub}
            >
              РИСК ({riskUsedThisCycle}/{maxRiskPerCycle})
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

