function useTypewriter(fullText, speed = 35) {
  const [displayed, setDisplayed] = useState("");
  const [done, setDone] = useState(false);
  const ref = useRef(null);
  useEffect(() => {
    setDisplayed("");
    setDone(false);
    let i = 0;
    clearInterval(ref.current);
    if (!fullText) return;
    ref.current = setInterval(() => {
      i++;
      setDisplayed(fullText.slice(0, i));
      if (i >= fullText.length) {
        clearInterval(ref.current);
        setTimeout(() => setDone(true), 300);
      }
    }, speed);
    return () => clearInterval(ref.current);
  }, [fullText, speed]);
  return { displayed, done };
}
function Floater({ id, text, color, x, y }) {
  return (
    <div
      key={id}
      style={{
        position: "absolute",
        top: y,
        left: x,
        color: color,
        fontSize: 14,
        fontWeight: "bold",
        textShadow: "1px 1px 0 #000",
        pointerEvents: "none",
        zIndex: 9999,
        animation: "floatUp 1s ease-out forwards",
      }}
    >
      {text}
    </div>
  );
}
function LivesTimer() {
  const [timeLeft, setTimeLeft] = useState("");
  useEffect(() => {
    const updateTimer = () => {
      const lastDeath =
        Number(localStorage.getItem("ernie_last_death_time")) || Date.now();
      const nextRestore = lastDeath + 3 * 60 * 60 * 1000;
      const diff = nextRestore - Date.now();
      if (diff <= 0) {
        setTimeLeft("Готово!");
        const currentLives = Number(localStorage.getItem("ernie_lives")) || 0;
        if (currentLives < 5) {
          localStorage.setItem("ernie_lives", currentLives + 1);
          localStorage.setItem("ernie_last_death_time", Date.now());
          window.location.reload();
        }
      } else {
        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        setTimeLeft(
          `${hours}:${String(minutes).padStart(2, "0")}:${String(
            seconds
          ).padStart(2, "0")}`
        );
      }
    };
    updateTimer();
    const interval = setInterval(updateTimer, 1000);
    return () => clearInterval(interval);
  }, []);
  return (
    <div
      style={{
        fontSize: 24,
        color: "#E94560",
        fontWeight: "bold",
        fontFamily: "monospace",
      }}
    >
      {timeLeft}
    </div>
  );
}

