            </div>
            <div
              style={{
                padding: 10,
                textAlign: "center",
                color: "#ccc",
                fontSize: 10,
                marginBottom: 10,
              }}
            >
              БАЛАНС: {influence} ВЛ
            </div>
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "1fr 1fr",
                gap: 10,
              }}
            >
              <button onClick={() => buyItem("battery", 4)} style={S.shopItem}>
                <div>🔋 БАТАРЕЯ</div>
                <div style={{ color: "#888", fontSize: 8 }}>+40 ЭН</div>
                <div>4 ВЛ</div>
              </button>
              <button onClick={() => buyItem("emp", 6)} style={S.shopItem}>
                <div>💣 ЭМИ</div>
                <div style={{ color: "#888", fontSize: 8 }}>50 УРОН</div>
                <div>6 ВЛ</div>
              </button>
              <button onClick={() => buyItem("stim", 5)} style={S.shopItem}>
                <div>💉 СТИМ</div>
                <div style={{ color: "#888", fontSize: 8 }}>СБРОС РИСКА</div>
