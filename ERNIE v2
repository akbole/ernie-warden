<div id="s1" class="scr"><div class="t-img"><img id="twImg" src="" alt=""></div><div class="t-ov"></div><div class="t-bot"><div class="t-lbl">ERNIE</div><div id="twT"></div><div id="twTap">нажми чтобы войти</div></div></div>
<div id="s2" class="scr"><div id="door"><div id="doorLbl">ЭТАЖ 1 · ГОРОД ЭХО</div></div><div id="doorHint">нажми на дверь</div></div>
<div id="sg" class="scr">
<div class="g-hud"><div class="g-hud-l" id="gFl">ЭТАЖ 1</div><div class="g-hud-r"><span>◆<span id="hK">0</span></span><span>♥<span id="hH">5</span></span></div></div>
<div class="g-top" id="gTop"><div class="d-spk" id="topSpk"></div><div class="d-txt" id="topTxt"></div></div>
<div class="g-imgw" id="gImgW"><img id="gI" src="" alt=""><div class="g-imgov"></div></div>
<div class="g-bot-wrap" id="gBotW">
<div class="g-bot" id="gBot"><div class="d-spk" id="botSpk"></div><div class="d-txt" id="botTxt"></div></div>
<div class="g-nav" id="gNav"><button onclick="nP()" id="nL">◀</button><div id="navC">1/1</div><button onclick="nN()" id="nR">▶</button></div>
<div id="gTap">нажми чтобы продолжить</div>
</div>
<div class="g-ch" id="gCh" style="display:none"></div>
<div class="g-bar" id="gBar" style="display:none"></div>
