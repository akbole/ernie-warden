<!DOCTYPE html>
<html lang="ru"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>ERNIE</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=JetBrains+Mono:wght@300;400&display=swap');
:root{--bg:#050508;--bg2:#0a0a10;--bg3:#12121e;--txt:#d8e0ec;--txt2:#90a0b8;--txtd:#506080;--txtb:#e8f0ff;--blue:#5a7fa0;--gold:#c8a848;--red:#b05050;--warm:#d8a050;--purple:#8a78b8}
*{margin:0;padding:0;box-sizing:border-box}html,body{width:100%;height:100dvh;overflow:hidden;scrollbar-width:none}html::-webkit-scrollbar,body::-webkit-scrollbar,.g-top::-webkit-scrollbar,.g-bot::-webkit-scrollbar,.g-ch::-webkit-scrollbar{display:none}
body{font-family:'Cormorant Garamond',Georgia,serif;background:var(--bg);color:var(--txt);user-select:none;-webkit-user-select:none;touch-action:manipulation}
button{font-family:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent;border:none;background:none}
img{display:block;width:100%;height:100%;object-fit:cover}
.scr{position:fixed;inset:0;display:flex;flex-direction:column;opacity:0;pointer-events:none;transition:opacity .6s;z-index:1}.scr.on{opacity:1;pointer-events:all;z-index:10}
@keyframes flk{0%,100%{opacity:.35}50%{opacity:1}}@keyframes scan{0%{top:-100%}100%{top:100%}}
@keyframes doorGlow{0%{box-shadow:0 0 30px rgba(200,180,120,.15),inset 0 0 20px rgba(200,180,120,.03)}100%{box-shadow:0 0 80px rgba(200,180,120,.35),inset 0 0 40px rgba(200,180,120,.06)}}
@keyframes doorOpen{0%{background:rgba(20,20,30,.95)}100%{background:rgba(200,180,120,.25);box-shadow:0 0 200px rgba(200,180,120,.4)}}
@keyframes catPulse{0%,100%{filter:drop-shadow(0 0 3px rgba(200,168,72,.2))}50%{filter:drop-shadow(0 0 8px rgba(200,168,72,.5))}}

#s0{background:#000;align-items:center;justify-content:center}
.aw-scan{position:absolute;width:100%;height:2px;background:rgba(74,107,138,.05);pointer-events:none;animation:scan 3s linear infinite}
#awT{font-family:'JetBrains Mono',monospace;font-size:22px;color:var(--txt);text-align:center;max-width:340px;line-height:2.2;letter-spacing:1px;padding:0 20px;white-space:pre-line}
#awTap{position:absolute;bottom:12%;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--txtd);letter-spacing:4px;animation:flk 2s ease infinite;display:none}

#s1{background:#000}.t-img{position:absolute;inset:0;z-index:1}.t-img img{object-fit:cover}
.t-ov{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.85),transparent 35%,transparent 60%,rgba(0,0,0,.5));z-index:2}
.t-bot{position:absolute;bottom:8%;left:0;right:0;text-align:center;z-index:3;padding:0 24px}
.t-lbl{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:4px;color:var(--blue);opacity:.5;margin-bottom:8px}
#twT{font-size:22px;color:var(--txt);line-height:2.2;white-space:pre-line}
#twTap{display:none;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--txtd);letter-spacing:3px;margin-top:16px;animation:flk 2s ease infinite}

#s2{background:#000;align-items:center;justify-content:center}
#door{width:120px;height:180px;border:1px solid rgba(200,180,120,.1);background:rgba(15,15,25,.95);position:relative;transition:all 1.8s ease;cursor:pointer}
#door.glow{border-color:rgba(200,180,120,.35);animation:doorGlow 2.5s ease infinite alternate}
#door.open{width:100vw;height:100dvh;border-color:transparent;animation:doorOpen 1.8s ease forwards;cursor:default}
#doorLbl{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:5px;color:var(--gold);opacity:0;transition:opacity .6s;white-space:nowrap;z-index:5}
#doorHint{display:none;position:absolute;bottom:18%;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--txtd);letter-spacing:3px;animation:flk 2s ease infinite}

/* === GAME: FLEXBOX LAYOUT === */
#sg{background:var(--bg)}
.g-hud{padding:6px 14px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.g-hud-l{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:3px;color:var(--blue);opacity:.6}
.g-hud-r{display:flex;gap:10px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--txtd)}.g-hud-r span{display:flex;align-items:center;gap:3px}

/* Top text */
.g-top{padding:2px 20px 4px;min-height:100px;height:100px;flex-shrink:0;overflow:hidden}

/* Center image - FIXED height, centered */
.g-imgw{width:100%;height:42vh;min-height:200px;overflow:hidden;flex-shrink:0;background:var(--bg2);position:relative}
.g-imgw img{object-fit:cover}
.g-imgov{position:absolute;inset:0;background:linear-gradient(0deg,var(--bg) 0%,transparent 8%,transparent 92%,var(--bg) 100%);pointer-events:none;z-index:2}

/* Bottom text + nav - takes remaining space */
.g-bot-wrap{flex:1;display:flex;flex-direction:column;overflow:hidden}
.g-bot{flex:1;padding:4px 20px;overflow-y:auto;scrollbar-width:none}

.d-spk{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:2px;margin-bottom:4px;padding:2px 10px;display:inline-block;border-radius:2px}
.spk-er{color:var(--blue);background:rgba(90,127,160,.1)}.spk-bo{color:var(--warm);background:rgba(216,160,80,.1)}.spk-li{color:var(--purple);background:rgba(138,120,184,.1)}.spk-ko{color:#70b8a0;background:rgba(112,184,160,.1)}.spk-mm{color:var(--red);background:rgba(176,80,80,.15)}.spk-bi{color:#a0c8a0;background:rgba(160,200,160,.1)}.spk-ak{color:#d4a0d4;background:rgba(212,160,212,.1)}
.d-txt{font-size:21px;line-height:1.5;color:var(--txt);white-space:pre-line}
.d-txt.stage{font-size:18px;color:var(--txt2);font-style:italic;text-align:center;line-height:1.5}
.d-txt.narr{font-size:19px;color:var(--txt2);font-style:italic;text-align:center}

.g-nav{display:flex;justify-content:space-between;align-items:center;padding:2px 16px;flex-shrink:0}
.g-nav button{width:44px;height:28px;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--txtd);border:1px solid rgba(74,107,138,.06);border-radius:2px}
.g-nav button:active{color:var(--blue)}.g-nav button:disabled{opacity:.12}
#navC{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--txtd)}
#gTap{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--txtd);letter-spacing:2px;text-align:center;padding:2px 0 6px;flex-shrink:0;animation:flk 2s ease infinite}

.g-ch{padding:6px 18px 10px;display:flex;flex-direction:column;gap:6px;max-height:60vh;overflow-y:auto;flex-shrink:0;justify-content:center;flex:1}
.g-cb{padding:13px 16px;background:var(--bg3);border:1px solid rgba(74,107,138,.08);color:var(--txt);font-size:18px;text-align:left;display:flex;align-items:center;gap:10px;border-radius:5px;line-height:1.4}
.g-cb:active{border-color:var(--blue);transform:translateX(3px)}.g-cb.used{opacity:.2;pointer-events:none}
.g-locs{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;padding:10px 2px;width:100%}
.g-loc{width:calc(50% - 7px);padding:16px 10px;background:var(--bg3);border:1px solid rgba(74,107,138,.08);border-radius:5px;display:flex;flex-direction:column;align-items:center;gap:5px}
.g-loc:active{border-color:var(--blue);transform:translateY(-2px)}.g-loc.done{opacity:.15;pointer-events:none}
.g-loc-i{font-size:28px}.g-loc-n{font-size:16px;color:var(--txtb);font-weight:600}.g-loc-h{font-size:13px;color:var(--txt2)}
.g-bar{padding:6px 18px 10px;flex-shrink:0}.g-bar button{width:100%;padding:14px;border:1px solid rgba(74,107,138,.12);color:var(--blue);font-size:13px;letter-spacing:3px;border-radius:3px}

#inv{position:fixed;bottom:10px;left:14px;z-index:50;display:none;gap:5px;align-items:center}
.inv-i{width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:17px;background:var(--bg3);border:1px solid rgba(74,107,138,.1);border-radius:50%}
.cat-glow{animation:catPulse 2s ease infinite;border-color:rgba(200,168,72,.2)}
.notif{position:fixed;top:40px;left:50%;transform:translateX(-50%) translateY(-12px);z-index:60;padding:10px 20px;border-radius:4px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:1px;pointer-events:none;opacity:0;transition:all .3s;white-space:nowrap;background:var(--bg3);border:1px solid rgba(200,168,72,.15);color:var(--gold)}
.notif.show{opacity:1;transform:translateX(-50%) translateY(0)}.nb{border-color:rgba(176,80,80,.15);color:var(--red)}
.dev-btn{position:fixed;top:4px;right:60px;z-index:90;padding:4px 8px;font-family:"JetBrains Mono",monospace;font-size:8px;color:var(--txtd);background:rgba(12,12,24,.8);border:1px solid rgba(74,107,138,.1);border-radius:3px;opacity:.4}
.fade{position:fixed;inset:0;background:#000;z-index:100;opacity:0;pointer-events:none;transition:opacity .5s}.fade.on{opacity:1;pointer-events:all}
</style></head><body>
<div class="notif" id="notif"></div><div class="fade" id="fade"></div><div id="inv"></div>
<div class="dev-btn" id="devBtn" onclick="devSkip()">DEV: ЭТАЖ 4 →</div>
